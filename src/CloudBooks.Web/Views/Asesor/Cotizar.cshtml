@model CloudBooks.Web.ModelosVista.CotizacionModelo
@{ ViewData["Title"] = "Crear cotización"; }
<section class="container pagina"><h1>Crear cotización</h1><p>La vigencia es de @ViewBag.DiasVigencia días y se aplica el cálculo institucional.</p>
<form asp-action="Cotizar" method="post" class="formulario formulario-institucional"><div asp-validation-summary="All" class="errores"></div><input asp-for="SolicitudId" type="hidden" />
<label asp-for="Concepto"></label><input asp-for="Concepto" /><label asp-for="Cantidad"></label><input asp-for="Cantidad" type="number" min="1" max="10000" /><label asp-for="PrecioUnitario"></label><input asp-for="PrecioUnitario" type="number" min="0.01" step="0.01" /><button class="boton" type="submit">Emitir cotización</button></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
