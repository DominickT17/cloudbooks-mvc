@model List<CloudBooks.Web.Modelos.Libro>
@using CloudBooks.Web.Modelos
@{ ViewData["Title"] = "Inicio"; }
<section class="hero"><div class="container hero-grid"><div class="hero-contenido"><p class="etiqueta">UNA LIBRERÍA PARA DESCUBRIR</p><h1>Las buenas ideas empiezan con un libro.</h1><p>Historias y conocimiento para personas e instituciones. Encuentra tu próxima lectura en CloudBooks.</p><div class="acciones-pedido"><a class="boton" asp-controller="Catalogo" asp-action="Index">Explorar catálogo <i data-lucide="arrow-right"></i></a><a class="boton-secundario" asp-action="Instituciones">Compras institucionales</a></div></div><div class="hero-visual" aria-hidden="true">@foreach (var libro in Model.Take(3)) { <img src="@libro.ImagenPortada" alt="" /> }<span>Una nueva historia te espera</span></div></div></section>
<section class="container seccion"><div class="seccion-titulo"><div><p class="etiqueta">PARA EMPEZAR A LEER</p><h2>Explora el catálogo</h2><p>Una selección de nuestras lecturas disponibles.</p></div><a asp-controller="Catalogo" asp-action="Index">Ver todos los libros →</a></div><div class="libros-grid">
@foreach (var libro in Model) { <partial name="_TarjetaLibro" model="libro" /> }
</div></section><section class="container seccion institucional-bloque"><div><p class="etiqueta">CLOUDBOOKS PARA INSTITUCIONES</p><h2>Más libros, más oportunidades.</h2><p>Compras por volumen, atención de un asesor y cotizaciones formales para tu institución.</p><a class="boton" asp-action="Instituciones">Conocer opciones institucionales</a></div><i data-lucide="building-2" aria-hidden="true"></i></section><section class="container seccion"><p class="etiqueta">PENSADO PARA TI</p><h2>¿Por qué CloudBooks?</h2><div class="beneficios"><article><i data-lucide="book-open"></i><h3>Catálogo accesible</h3><p>Encuentra lecturas por título, autor o categoría.</p></article><article><i data-lucide="shopping-bag"></i><h3>Compra sencilla</h3><p>Organiza tus libros y consulta tus pedidos.</p></article><article><i data-lucide="users-round"></i><h3>Atención institucional</h3><p>Solicita una cotización para tu institución.</p></article></div></section>
