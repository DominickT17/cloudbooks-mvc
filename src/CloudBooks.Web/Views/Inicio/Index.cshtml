@model CloudBooks.Web.ModelosVista.InicioModelo
@{ ViewData["Title"] = "Inicio"; }
<section class="hero"><div class="container hero-grid"><div class="hero-contenido"><p class="etiqueta">UNA LIBRERÍA PARA DESCUBRIR</p><h1>Las buenas ideas empiezan con un libro.</h1><p>Historias y conocimiento para personas e instituciones. Encuentra tu próxima lectura en CloudBooks.</p><div class="acciones-pedido"><a class="boton" asp-controller="Catalogo" asp-action="Index">Explorar catálogo <i data-lucide="arrow-right"></i></a><a class="boton-secundario" asp-action="Instituciones">Compras institucionales</a></div></div><div class="hero-visual" aria-hidden="true">@foreach (var libro in Model.Libros.Take(3)) { <img src="@libro.ImagenPortada" alt="" /> }<span>Una nueva historia te espera</span></div></div></section>
<section class="container busca-inicio"><div><p class="etiqueta">ENCUENTRA TU PRÓXIMA LECTURA</p><h2>¿Qué quieres leer hoy?</h2></div><form asp-controller="Catalogo" asp-action="Index" method="get" role="search"><label class="visually-hidden" for="busqueda-inicio">Buscar por título, autor o ISBN</label><i data-lucide="search" aria-hidden="true"></i><input id="busqueda-inicio" name="Buscar" placeholder="Busca por título, autor o ISBN" /><button class="boton" type="submit">Buscar</button></form></section>
<div class="franja-beneficios"><div class="container"><span><i data-lucide="book-open"></i> Catálogo fácil de explorar</span><span><i data-lucide="library"></i> Descuentos por volumen</span><span><i data-lucide="users-round"></i> Atención institucional</span></div></div>
<section class="container seccion"><div class="seccion-titulo"><div><p class="etiqueta">PARA EMPEZAR A LEER</p><h2>@(Model.SonMasVendidos ? "Más vendidos" : "Lecturas destacadas")</h2><p>@(Model.SonMasVendidos ? "Las lecturas elegidas por nuestros clientes." : "Una selección de nuestro catálogo.")</p></div><a asp-controller="Catalogo" asp-action="Index">Ver todos los libros →</a></div><div class="libros-grid">@foreach (var libro in Model.Libros) { <partial name="_TarjetaLibro" model="libro" /> }</div></section>
@if (Model.Categorias.Count > 0) { <section class="container seccion"><p class="etiqueta">ENCUENTRA TU TEMA</p><h2>Explora por categoría</h2><div class="categorias-grid">@foreach (var categoria in Model.Categorias) { <a asp-controller="Catalogo" asp-action="Index" asp-route-CategoriaId="@categoria.Id"><i data-lucide="@(categoria.Nombre.ToLowerInvariant() switch { "educación" => "graduation-cap", "historia" => "landmark", "narrativa" => "book-open", "tecnología" => "monitor", _ => "book-open" })"></i><span>@categoria.Nombre</span><span aria-hidden="true">→</span></a> }</div></section> }
@if (Model.Recomendados.Count > 0) { <section class="container seccion"><p class="etiqueta">NUESTRA SELECCIÓN</p><h2>Recomendados por CloudBooks</h2><div class="libros-grid">@foreach (var libro in Model.Recomendados) { <partial name="_TarjetaLibro" model="libro" /> }</div></section> }
<section class="container seccion institucional-bloque"><div><p class="etiqueta">CLOUDBOOKS PARA INSTITUCIONES</p><h2>Más libros, más oportunidades.</h2><p>Compras por volumen, atención de un asesor y cotizaciones formales para tu institución.</p><a class="boton" asp-action="Instituciones">Conocer opciones institucionales</a></div><i data-lucide="building-2" aria-hidden="true"></i></section>
@if (Model.Recientes.Count > 0) { <section class="container seccion"><p class="etiqueta">CONTINÚA EXPLORANDO</p><h2>Vistos recientemente</h2><div class="libros-grid">@foreach (var libro in Model.Recientes) { <partial name="_TarjetaLibro" model="libro" /> }</div></section> }
