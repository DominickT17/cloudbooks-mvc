@{ ViewData["Title"] = "Instituciones"; }
<section class="container pagina institucional-pagina"><p class="etiqueta">CLOUDBOOKS PARA INSTITUCIONES</p><h1>Lecturas que llegan más lejos</h1><p class="intro">Encuentra una forma sencilla de comprar libros para tu institución, con atención de un asesor y una cotización formal.</p><div class="acciones-pedido">
@if (User.IsInRole("ClienteMinorista") && !User.IsInRole("ClienteInstitucional")) { <a class="boton" asp-controller="Instituciones" asp-action="Solicitar">Solicitar cuenta institucional</a><a class="boton-secundario" asp-controller="Instituciones" asp-action="MisSolicitudes">Mis solicitudes</a> }
else if (User.IsInRole("ClienteInstitucional")) { <a class="boton" asp-controller="Solicitudes" asp-action="Crear">Nueva solicitud especial</a><a class="boton-secundario" asp-controller="Cotizaciones" asp-action="Index">Mis cotizaciones</a> }
else if (User.IsInRole("Administrador")) { <a class="boton" asp-controller="AdministracionInstituciones" asp-action="Index">Revisar solicitudes</a> }
else if (User.Identity?.IsAuthenticated != true) { <a class="boton" asp-controller="Cuenta" asp-action="Registrar" asp-route-returnUrl="/Inicio/Instituciones">Crear cuenta</a><a class="boton-secundario" asp-controller="Cuenta" asp-action="Ingresar" asp-route-returnUrl="/Inicio/Instituciones">Iniciar sesión</a> }
</div><div class="beneficios"><article><i data-lucide="books"></i><h3>Compras por volumen</h3><p>Descuentos según la cantidad de libros.</p></article><article><i data-lucide="file-text"></i><h3>Cotización formal</h3><p>Consulta y descarga tu propuesta en PDF.</p></article><article><i data-lucide="users-round"></i><h3>Atención institucional</h3><p>Un asesor disponible atiende tu solicitud.</p></article></div><h2 class="proceso-titulo">¿Cómo funciona?</h2><div class="pasos"><p><strong>1</strong> Solicita tu cuenta</p><p><strong>2</strong> Un administrador la valida</p><p><strong>3</strong> Solicita una cotización</p><p><strong>4</strong> Recibe atención de un asesor</p></div></section>
