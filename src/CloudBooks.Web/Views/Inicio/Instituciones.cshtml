@{ ViewData["Title"] = "Instituciones"; }
<section class="container pagina"><p class="etiqueta">CLOUDBOOKS PARA INSTITUCIONES</p><h1>Lecturas que llegan más lejos</h1><p>Conectamos instituciones con lecturas y soluciones editoriales para sus necesidades.</p><div class="acciones-pedido">
@if (User.IsInRole("ClienteMinorista") && !User.IsInRole("ClienteInstitucional")) { <a class="boton" asp-controller="Instituciones" asp-action="Solicitar">Solicitar cuenta institucional</a><a asp-controller="Instituciones" asp-action="MisSolicitudes">Mis solicitudes institucionales</a> }
else if (User.IsInRole("ClienteInstitucional")) { <a class="boton" asp-controller="Solicitudes" asp-action="Crear">Nueva solicitud especial</a><a asp-controller="Solicitudes" asp-action="Index">Mis solicitudes especiales</a><a asp-controller="Cotizaciones" asp-action="Index">Mis cotizaciones</a> }
else if (User.IsInRole("Administrador")) { <a class="boton" asp-controller="AdministracionInstituciones" asp-action="Index">Revisar solicitudes</a> }
else if (User.Identity?.IsAuthenticated != true) { <a class="boton" asp-controller="Cuenta" asp-action="Ingresar" asp-route-returnUrl="/Inicio/Instituciones">Iniciar sesión</a> }
</div><a asp-controller="Catalogo" asp-action="Index">Explorar catálogo</a></section>
