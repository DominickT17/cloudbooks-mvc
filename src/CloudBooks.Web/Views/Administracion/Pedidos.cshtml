@model List<CloudBooks.Web.Modelos.Pedido>
@using CloudBooks.Web.Modelos
@{ ViewData["Title"] = "Pedidos"; var todos = (List<Pedido>)ViewBag.Resumen; string Dinero(decimal n) => "Q" + n.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture); }
<section class="container pagina"><div class="admin-pagina-encabezado"><p class="etiqueta">OPERACIONES</p><h1>Pedidos</h1><p>Consulta las compras y atiende las operaciones que requieren revisión.</p></div>
<div class="admin-resumen-pedidos"><div><span>Pendientes</span><strong>@todos.Count(p => p.Estado == EstadoPedido.Pendiente)</strong></div><div><span>Aprobados</span><strong>@todos.Count(p => p.Estado == EstadoPedido.Aprobado)</strong></div><div><span>En revisión</span><strong>@todos.Count(p => p.Estado == EstadoPedido.EnRevision)</strong></div><div><span>Enviados</span><strong>@todos.Count(p => p.Estado == EstadoPedido.Enviado)</strong></div><div><span>Cancelados</span><strong>@todos.Count(p => p.Estado == EstadoPedido.Cancelado || p.Estado == EstadoPedido.CanceladoPorSeguridad)</strong></div></div>
<div class="admin-panel"><div class="admin-panel-cabecera"><div><h2>Registro de pedidos</h2><p>@Model.Count resultado(s) para los filtros seleccionados.</p></div></div><form method="get" class="admin-filtros"><div><label for="buscar">Cliente o pedido</label><input id="buscar" name="buscar" value="@Context.Request.Query["buscar"]" placeholder="Nombre, correo o código" /></div><div><label for="estado">Estado</label><select id="estado" name="estado"><option value="">Todos</option>@foreach (var estado in Enum.GetValues<EstadoPedido>()) { <option value="@estado" selected="@(ViewBag.Estado == estado)">@(new Pedido { Estado = estado }.EstadoTexto)</option> }</select></div><div><label for="tipo">Tipo de revisión</label><select id="tipo" name="tipo"><option value="">Todas</option>@foreach (var tipo in new[] { TipoRevisionPedido.Seguridad, TipoRevisionPedido.Comercial, TipoRevisionPedido.Inventario }) { <option value="@tipo" selected="@(Context.Request.Query["tipo"] == tipo.ToString())">@tipo</option> }</select></div><div><label for="fecha">Fecha (UTC)</label><input id="fecha" name="fecha" type="date" value="@Context.Request.Query["fecha"]" /></div><button type="submit" class="boton-secundario">Filtrar</button></form>
@if (Model.Count == 0) { <div class="admin-vacio"><i data-lucide="shopping-bag"></i><strong>No hay pedidos para mostrar</strong><span>Los pedidos que coincidan con los filtros aparecerán aquí.</span><a asp-action="Pedidos">Ver todos los pedidos</a></div> } else { <div class="tabla-responsive"><table class="tabla-pedidos"><thead><tr><th>Pedido</th><th>Cliente</th><th>Fecha (UTC)</th><th>Total</th><th>Pago</th><th>Revisión</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach (var pedido in Model) { <tr><td><strong>@pedido.Codigo</strong></td><td>@pedido.Usuario.NombreCompleto</td><td>@pedido.FechaUtc.ToString("dd/MM/yyyy HH:mm")</td><td>@Dinero(pedido.Total)</td><td>@(pedido.EstadoPago == EstadoPago.NoRegistrado ? "Histórico" : pedido.EstadoPago.ToString())</td><td>@(pedido.TipoRevision == TipoRevisionPedido.Ninguna ? (pedido.MotivosRevision == null ? "Sin alertas" : "Histórica") : pedido.TipoRevision.ToString())</td><td><span class="estado-admin estado-@pedido.Estado.ToString().ToLowerInvariant()">@pedido.EstadoTexto</span></td><td><a asp-action="DetallePedido" asp-route-id="@pedido.Id">Ver detalle →</a></td></tr> }
</tbody></table></div> }</div></section>
