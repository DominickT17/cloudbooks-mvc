@model List<CloudBooks.Web.Modelos.Pedido>
@using CloudBooks.Web.Modelos
@using CloudBooks.Web.ModelosVista
@{ ViewData["Title"] = "Pedidos"; var todos = (List<Pedido>)ViewBag.Resumen; string Dinero(decimal n) => "Q" + n.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture); }
<section class="container pagina">
    <div class="admin-pagina-encabezado admin-bloque-cabecera"><div><p class="etiqueta">OPERACIONES · VENTAS</p><h1>Pedidos</h1><p>Consulta las compras, revisa sus condiciones y continúa con las acciones disponibles.</p></div></div>
    <div class="admin-resumen-pedidos" aria-label="Resumen de pedidos">
        <div><span>Pendientes</span><strong>@todos.Count(p => p.Estado == EstadoPedido.Pendiente)</strong></div>
        <div class="resumen-atencion"><span>En revisión</span><strong>@todos.Count(p => p.Estado == EstadoPedido.EnRevision)</strong></div>
        <div><span>Aprobados</span><strong>@todos.Count(p => p.Estado == EstadoPedido.Aprobado)</strong></div>
        <div><span>Enviados</span><strong>@todos.Count(p => p.Estado == EstadoPedido.Enviado)</strong></div>
        <div><span>Cancelados</span><strong>@todos.Count(p => p.Estado == EstadoPedido.Cancelado || p.Estado == EstadoPedido.CanceladoPorSeguridad)</strong></div>
    </div>
    <div class="admin-panel">
        <div class="admin-tabla-titulo"><div><h2>Registro de pedidos</h2><p>@Model.Count resultado(s) · Las fechas se muestran en hora de Guatemala.</p></div></div>
        <form method="get" class="admin-filtros">
            <div><label for="buscar">Cliente o pedido</label><input id="buscar" name="buscar" value="@Context.Request.Query["buscar"]" placeholder="Nombre, correo o código" /></div>
            <div><label for="estado">Estado</label><select id="estado" name="estado"><option value="">Todos</option>@foreach (var estado in Enum.GetValues<EstadoPedido>()) { <option value="@estado" selected="@(ViewBag.Estado == estado)">@(new Pedido { Estado = estado }.EstadoTexto)</option> }</select></div>
            <div><label for="tipo">Tipo de revisión</label><select id="tipo" name="tipo"><option value="">Todas</option>@foreach (var tipo in new[] { TipoRevisionPedido.Seguridad, TipoRevisionPedido.Comercial, TipoRevisionPedido.Inventario }) { <option value="@tipo" selected="@(Context.Request.Query["tipo"] == tipo.ToString())">@tipo</option> }</select></div>
            <div><label for="prioridad">Prioridad</label><select id="prioridad" name="prioridad"><option value="">Todas</option><option value="true" selected="@(Context.Request.Query["prioridad"] == "true")">Alta</option><option value="false" selected="@(Context.Request.Query["prioridad"] == "false")">Normal</option></select></div>
            <div><label for="fecha">Fecha en Guatemala</label><input id="fecha" name="fecha" type="date" value="@Context.Request.Query["fecha"]" /></div>
            <button type="submit" class="boton-secundario">Filtrar</button><a class="admin-limpiar" asp-action="Pedidos">Limpiar</a>
        </form>
        @if (Model.Count == 0) { <div class="admin-vacio"><i data-lucide="shopping-bag"></i><strong>No hay pedidos para mostrar</strong><span>Prueba otros filtros para encontrar una compra.</span><a asp-action="Pedidos">Ver todos los pedidos</a></div> }
        else { <div class="tabla-responsive" tabindex="0" aria-label="Lista de pedidos; desplázate horizontalmente para ver todas las columnas"><table class="tabla-pedidos"><thead><tr><th>Pedido</th><th>Cliente</th><th>Fecha</th><th>Total</th><th>Pago</th><th>Revisión</th><th>Estado</th><th>Acción</th></tr></thead><tbody>
        @foreach (var pedido in Model) { <tr><td><strong>@pedido.Codigo</strong>@if (pedido.AltaPrioridad) { <small class="admin-prioridad">Prioridad alta</small> }</td><td>@pedido.Usuario.NombreCompleto</td><td><span class="admin-fecha">@FechaPresentacion.Mostrar(pedido.FechaUtc)</span></td><td><strong>@Dinero(pedido.Total)</strong></td><td>@(pedido.EstadoPago == EstadoPago.NoRegistrado ? "Histórico" : pedido.EstadoPago.ToString())</td><td>@(pedido.TipoRevision == TipoRevisionPedido.Ninguna ? (pedido.MotivosRevision == null ? "Sin alertas" : "Histórica") : pedido.TipoRevision.ToString())</td><td><span class="estado-admin estado-@pedido.Estado.ToString().ToLowerInvariant()">@pedido.EstadoTexto</span></td><td><a class="admin-accion" asp-action="DetallePedido" asp-route-id="@pedido.Id">Ver detalle <i data-lucide="arrow-right"></i></a></td></tr> }
        </tbody></table></div> }
    </div>
</section>
