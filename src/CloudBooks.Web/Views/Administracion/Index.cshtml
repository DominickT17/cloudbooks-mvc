@model CloudBooks.Web.ModelosVista.DashboardModelo
@{ ViewData["Title"] = "Dashboard"; string Dinero(decimal n) => "Q" + n.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture); }
<section class="container pagina admin-inicio">
<div class="admin-bienvenida"><div><p class="etiqueta">CENTRO DE OPERACIONES</p><h1>Tu librería, de un vistazo.</h1><p>Consulta las ventas, atiende los pendientes y sigue el movimiento de CloudBooks.</p></div><a class="boton" asp-controller="AdministracionCatalogo" asp-action="Crear"><i data-lucide="plus"></i> Nuevo libro</a></div>
<div class="admin-resumen-titulo"><div><p class="etiqueta">RESUMEN COMERCIAL</p><h2>La operación en cifras</h2></div><span>Datos actuales de CloudBooks</span></div>
<div class="admin-metricas"><article class="metrica-principal"><span><i data-lucide="wallet"></i> Ventas válidas</span><strong>@Dinero(Model.Ventas)</strong><small>Pedidos aprobados y enviados</small></article><article><span><i data-lucide="shopping-bag"></i> Aprobados</span><strong>@Model.Aprobados</strong><small>Listos para preparar</small></article><article><span><i data-lucide="package-check"></i> Enviados</span><strong>@Model.Enviados</strong><small>Pedidos completados</small></article><article><span><i data-lucide="users-round"></i> Clientes</span><strong>@Model.Clientes</strong><small>Cuentas registradas</small></article></div>
<div class="admin-tablero"><section class="admin-panel atencion"><div class="admin-panel-cabecera"><div><p class="etiqueta">PRIORIDADES</p><h2>Atención requerida</h2><p>Un pedido puede aparecer en más de un tipo de revisión.</p></div><span class="admin-icono"><i data-lucide="bell-ring"></i></span></div><div class="admin-lista-atencion">
<a class="@(Model.RevisionSeguridad > 0 ? "requiere-atencion" : "")" asp-controller="Administracion" asp-action="Pedidos" asp-route-estado="EnRevision" asp-route-tipo="Seguridad"><span><i data-lucide="shield-alert"></i><span><strong>Seguridad</strong><small>Validación de titular</small></span></span><b>@Model.RevisionSeguridad</b></a>
<a class="@(Model.RevisionComercial > 0 ? "requiere-atencion" : "")" asp-controller="Administracion" asp-action="Pedidos" asp-route-estado="EnRevision" asp-route-tipo="Comercial"><span><i data-lucide="shopping-bag"></i><span><strong>Revisión comercial</strong><small>Condiciones por verificar</small></span></span><b>@Model.RevisionComercial</b></a>
<a class="@(Model.RevisionInventario > 0 ? "requiere-atencion" : "")" asp-controller="Administracion" asp-action="Pedidos" asp-route-estado="EnRevision" asp-route-tipo="Inventario"><span><i data-lucide="package-search"></i><span><strong>Revisión de inventario</strong><small>Disponibilidad por confirmar</small></span></span><b>@Model.RevisionInventario</b></a>
<a asp-controller="AdministracionInstituciones" asp-action="Index"><span><i data-lucide="building-2"></i><span><strong>Solicitudes institucionales</strong><small>Revisa las nuevas solicitudes</small></span></span><b>@Model.SolicitudesInstitucionalesPendientes</b></a>
<a asp-controller="AdministracionSolicitudes" asp-action="Index"><span><i data-lucide="clipboard-list"></i><span><strong>Solicitudes comerciales</strong><small>Solicitadas o en revisión</small></span></span><b>@Model.SolicitudesComercialesPendientes</b></a>
<a asp-controller="Cotizaciones" asp-action="Administracion"><span><i data-lucide="file-text"></i><span><strong>Cotizaciones pendientes</strong><small>En espera de respuesta</small></span></span><b>@Model.CotizacionesPendientes</b></a>
<a asp-controller="AdministracionInventario" asp-action="Index"><span><i data-lucide="boxes"></i><span><strong>Inventario bajo</strong><small>Libros que podrían necesitar reposición</small></span></span><b>@Model.StockBajo.Count</b></a></div></section>
<div class="admin-columna"><section class="admin-panel"><div class="admin-panel-cabecera"><div><p class="etiqueta">MOVIMIENTO</p><h2>Actividad reciente</h2><p>Registros recientes · hora de Guatemala.</p></div><a asp-action="Pedidos">Ver pedidos →</a></div>@if (Model.Actividad.Count == 0) { <div class="admin-vacio"><i data-lucide="clock-3"></i><strong>Sin movimientos todavía</strong><span>Los registros recientes aparecerán aquí.</span></div> } else { <div class="admin-actividad">@foreach (var evento in Model.Actividad) { var destino = evento.Tipo == "pedido" ? Url.Action("DetallePedido", "Administracion", new { id = evento.Id }) : evento.Tipo == "institucion" ? Url.Action("Detalle", "AdministracionInstituciones", new { id = evento.Id }) : Url.Action("Detalle", "Cotizaciones", new { id = evento.Id }); <a href="@destino"><span class="actividad-punto"></span><span><strong>@evento.Titulo</strong><small>@evento.Detalle · @CloudBooks.Web.ModelosVista.FechaPresentacion.Mostrar(evento.FechaUtc)</small></span><i data-lucide="arrow-up-right"></i></a> }</div> }</section>
<section class="admin-panel"><div class="admin-panel-cabecera"><div><p class="etiqueta">ATAJOS</p><h2>Acciones rápidas</h2></div></div><div class="admin-atajos"><a asp-action="Pedidos"><i data-lucide="shopping-bag"></i> Gestionar pedidos</a><a asp-controller="AdministracionInventario" asp-action="Index"><i data-lucide="boxes"></i> Actualizar inventario</a><a asp-controller="AdministracionInstituciones" asp-action="Index"><i data-lucide="building-2"></i> Ver instituciones</a><a asp-controller="Cotizaciones" asp-action="Administracion"><i data-lucide="file-text"></i> Ver cotizaciones</a></div></section></div></div>
<div class="dashboard-grid admin-inferior"><section class="admin-panel"><div class="admin-panel-cabecera"><div><p class="etiqueta">PANORAMA</p><h2>Pedidos por estado</h2></div></div><div class="grafica"><canvas id="grafica-pedidos" aria-label="Pedidos por estado" role="img" data-pendientes="@Model.Pendientes" data-revision="@Model.EnRevision" data-aprobados="@Model.Aprobados" data-enviados="@Model.Enviados" data-cancelados="@Model.Cancelados"></canvas></div><p class="admin-nota">Pendientes @Model.Pendientes · Revisión @Model.EnRevision · Aprobados @Model.Aprobados · Enviados @Model.Enviados · Cancelados @Model.Cancelados</p></section><section class="admin-panel"><div class="admin-panel-cabecera"><div><p class="etiqueta">CATÁLOGO</p><h2>Libros más vendidos</h2><p>Unidades en pedidos aprobados y enviados.</p></div></div>@if (Model.MasVendidos.Count == 0) { <div class="admin-vacio"><i data-lucide="book-open"></i><strong>Aún no hay ventas aprobadas</strong><span>El ranking aparecerá cuando se registren ventas.</span></div> } else { <ol class="admin-ranking">@foreach (var libro in Model.MasVendidos) { <li>@libro.Titulo <strong>@libro.Unidades unidades</strong></li> }</ol> }</section></div>
</section>
@section Scripts { <script src="~/lib/chartjs/chart.umd.min.js"></script><script src="~/js/dashboard.js" asp-append-version="true"></script> }
