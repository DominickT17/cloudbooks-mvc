@model CloudBooks.Web.ModelosVista.DashboardModelo
@{ ViewData["Title"] = "Dashboard"; string Dinero(decimal n) => "Q" + n.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture); }
<section class="container pagina admin-inicio">
<div class="admin-bienvenida"><div><p class="etiqueta">CENTRO DE OPERACIONES</p><h1>Tu librería, de un vistazo.</h1><p>Consulta las ventas, atiende los pendientes y sigue el movimiento de CloudBooks.</p></div><a class="boton" asp-controller="AdministracionCatalogo" asp-action="Crear"><i data-lucide="plus"></i> Nuevo libro</a></div>
<div class="admin-metricas"><article class="metrica-principal"><span><i data-lucide="wallet"></i> Ventas válidas</span><strong>@Dinero(Model.Ventas)</strong><small>Pedidos aprobados y enviados</small></article><article><span><i data-lucide="shopping-bag"></i> Aprobados</span><strong>@Model.Aprobados</strong><small>Listos para preparar</small></article><article><span><i data-lucide="users-round"></i> Clientes</span><strong>@Model.Clientes</strong><small>Cuentas registradas</small></article><article><span><i data-lucide="package-check"></i> Enviados</span><strong>@Model.Enviados</strong><small>Pedidos completados</small></article></div>
<div class="admin-tablero"><section class="admin-panel atencion"><div class="admin-panel-cabecera"><div><p class="etiqueta">PRIORIDADES</p><h2>Atención requerida</h2><p>Elementos que necesitan seguimiento.</p></div><span class="admin-icono"><i data-lucide="bell-ring"></i></span></div><div class="admin-lista-atencion">
<a asp-controller="Administracion" asp-action="Pedidos" asp-route-estado="EnRevision"><span><i data-lucide="shield-alert"></i><span><strong>Revisiones de pedidos</strong><small>Comprueba las alertas registradas</small></span></span><b>@Model.EnRevision</b></a>
<a asp-controller="Administracion" asp-action="Pedidos" asp-route-estado="Pendiente"><span><i data-lucide="shopping-bag"></i><span><strong>Pedidos pendientes</strong><small>Operaciones por atender</small></span></span><b>@Model.Pendientes</b></a>
<a asp-controller="AdministracionInstituciones" asp-action="Index"><span><i data-lucide="building-2"></i><span><strong>Solicitudes institucionales</strong><small>Revisa las nuevas solicitudes</small></span></span><b>@Model.SolicitudesInstitucionalesPendientes</b></a>
<a asp-controller="Cotizaciones" asp-action="Administracion"><span><i data-lucide="file-text"></i><span><strong>Cotizaciones pendientes</strong><small>En espera de respuesta</small></span></span><b>@Model.CotizacionesPendientes</b></a>
<a asp-controller="AdministracionInventario" asp-action="Index"><span><i data-lucide="boxes"></i><span><strong>Inventario bajo</strong><small>Libros que podrían necesitar reposición</small></span></span><b>@Model.StockBajo.Count</b></a></div></section>
<div class="admin-columna"><section class="admin-panel"><div class="admin-panel-cabecera"><div><p class="etiqueta">MOVIMIENTO</p><h2>Actividad reciente</h2><p>Últimos pedidos registrados.</p></div><a asp-action="Pedidos">Ver todos →</a></div>@if (Model.PedidosRecientes.Count == 0) { <div class="admin-vacio"><i data-lucide="clock-3"></i><strong>Sin movimientos todavía</strong><span>Los pedidos recientes aparecerán aquí.</span></div> } else { <div class="admin-actividad">@foreach (var pedido in Model.PedidosRecientes) { <a asp-action="DetallePedido" asp-route-id="@pedido.Id"><span class="actividad-punto"></span><span><strong>@pedido.Codigo</strong><small>@pedido.FechaUtc.ToString("dd/MM/yyyy HH:mm") UTC</small></span><span class="estado-admin">@pedido.EstadoTexto</span></a> }</div> }</section>
<section class="admin-panel"><div class="admin-panel-cabecera"><div><p class="etiqueta">ATAJOS</p><h2>Acciones rápidas</h2></div></div><div class="admin-atajos"><a asp-action="Pedidos"><i data-lucide="shopping-bag"></i> Pedidos</a><a asp-action="Pedidos" asp-route-estado="EnRevision"><i data-lucide="shield-check"></i> Revisiones</a><a asp-controller="AdministracionInventario" asp-action="Index"><i data-lucide="boxes"></i> Inventario</a><a asp-controller="AdministracionInstituciones" asp-action="Index"><i data-lucide="building-2"></i> Instituciones</a><a asp-controller="Cotizaciones" asp-action="Administracion"><i data-lucide="file-text"></i> Cotizaciones</a></div></section></div></div>
<div class="dashboard-grid admin-inferior"><section class="admin-panel"><div class="admin-panel-cabecera"><div><p class="etiqueta">PANORAMA</p><h2>Pedidos por estado</h2></div></div><div class="grafica"><canvas id="grafica-pedidos" aria-label="Pedidos por estado" role="img" data-pendientes="@Model.Pendientes" data-revision="@Model.EnRevision" data-aprobados="@Model.Aprobados" data-enviados="@Model.Enviados" data-cancelados="@Model.Cancelados"></canvas></div><p class="admin-nota">Pendientes @Model.Pendientes · Revisión @Model.EnRevision · Aprobados @Model.Aprobados · Enviados @Model.Enviados · Cancelados @Model.Cancelados</p></section><section class="admin-panel"><div class="admin-panel-cabecera"><div><p class="etiqueta">CATÁLOGO</p><h2>Libros más vendidos</h2><p>Unidades en pedidos aprobados y enviados.</p></div></div>@if (Model.MasVendidos.Count == 0) { <div class="admin-vacio"><i data-lucide="book-open"></i><strong>Aún no hay ventas aprobadas</strong><span>El ranking aparecerá cuando se registren ventas.</span></div> } else { <ol class="admin-ranking">@foreach (var libro in Model.MasVendidos) { <li>@libro.Titulo <strong>@libro.Unidades unidades</strong></li> }</ol> }</section></div>
</section>
@section Scripts { <script src="~/lib/chartjs/chart.umd.min.js"></script><script src="~/js/dashboard.js" asp-append-version="true"></script> }
