@model CloudBooks.Web.ModelosVista.DashboardModelo
@{ ViewData["Title"] = "Administración"; string Dinero(decimal n) => "Q" + n.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture); }
<section class="container pagina"><p class="etiqueta">CLOUDBOOKS · ADMINISTRACIÓN</p><h1>Dashboard</h1><p>Una vista de las operaciones de CloudBooks.</p>
<div class="indicadores"><div><span>Ventas válidas</span><strong>@Dinero(Model.Ventas)</strong></div><div><span>Pedidos totales</span><strong>@Model.Pedidos</strong></div><div><span>Pendientes</span><strong>@Model.Pendientes</strong></div><div><span>Aprobados</span><strong>@Model.Aprobados</strong></div><div><span>Enviados</span><strong>@Model.Enviados</strong></div><div><span>Cotizaciones pendientes</span><strong>@Model.CotizacionesPendientes</strong></div><div><span>Clientes</span><strong>@Model.Clientes</strong></div><div><span>Institucionales</span><strong>@Model.Institucionales</strong></div><div><span>Libros con stock bajo</span><strong>@Model.StockBajo.Count</strong></div></div>
<div class="admin-acciones"><a class="boton" asp-controller="AdministracionCatalogo" asp-action="Crear">Nuevo libro</a><a class="boton-secundario" asp-controller="Administracion" asp-action="Pedidos">Revisar pedidos</a><a class="boton-secundario" asp-controller="AdministracionInstituciones" asp-action="Index">Solicitudes institucionales</a><a class="boton-secundario" asp-controller="AdministracionInventario" asp-action="Index">Ver inventario</a></div>
<div class="panel-dashboard pendientes-admin"><h2>Pendientes de atención</h2><div><a asp-controller="Administracion" asp-action="Pedidos" asp-route-estado="Pendiente">@Model.Pendientes pedidos por revisar</a><a asp-controller="AdministracionInstituciones" asp-action="Index">@Model.SolicitudesInstitucionalesPendientes solicitudes institucionales pendientes</a><a asp-controller="Cotizaciones" asp-action="Administracion">@Model.CotizacionesPendientes cotizaciones pendientes</a><a asp-controller="AdministracionInventario" asp-action="Index">@Model.StockBajo.Count libros con stock bajo</a></div></div>
<p class="texto-secundario">Las ventas y el ranking incluyen pedidos aprobados y enviados.</p>
<div class="dashboard-grid"><div class="panel-dashboard"><h2>Pedidos por estado</h2><div class="grafica"><canvas id="grafica-pedidos" aria-label="Pedidos por estado" role="img" data-pendientes="@Model.Pendientes" data-aprobados="@Model.Aprobados" data-enviados="@Model.Enviados" data-cancelados="@Model.Cancelados"></canvas></div><p>Pendientes: @Model.Pendientes · Aprobados: @Model.Aprobados · Enviados: @Model.Enviados · Cancelados: @Model.Cancelados</p></div>
<div class="panel-dashboard"><h2>Libros más vendidos</h2>@if (Model.MasVendidos.Count == 0) { <p>Aún no hay ventas aprobadas.</p> } else { <ol>@foreach (var libro in Model.MasVendidos) { <li>@libro.Titulo — @libro.Unidades unidades</li> }</ol> }</div></div>
<div class="panel-dashboard"><h2>Stock bajo</h2>@if (Model.StockBajo.Count == 0) { <p>No hay libros con stock bajo.</p> } else { <ul>@foreach (var libro in Model.StockBajo) { <li>@libro.Titulo — @libro.Stock unidades</li> }</ul> }<a asp-controller="AdministracionInventario" asp-action="Index">Ver inventario</a></div></section>
@section Scripts { <script src="~/lib/chartjs/chart.umd.min.js"></script><script src="~/js/dashboard.js" asp-append-version="true"></script> }
