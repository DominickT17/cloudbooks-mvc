@model CloudBooks.Web.Modelos.Pedido
@using CloudBooks.Web.Modelos
@{ ViewData["Title"] = Model.Codigo; string Dinero(decimal n) => "Q" + n.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture); var enlaceWhatsapp = CloudBooks.Web.Servicios.ContactoWhatsapp.CrearEnlace(Model.Usuario.PhoneNumber, $"Hola {Model.Usuario.NombreCompleto}, somos CloudBooks. Nos comunicamos por tu pedido {Model.Codigo}. ¿Podrías ayudarnos a confirmar la compra?"); }
<section class="container pagina"><a asp-action="Pedidos">← Volver a pedidos</a><div class="admin-pagina-encabezado"><p class="etiqueta">DETALLE DE COMPRA</p><h1>@Model.Codigo</h1><p>@Model.FechaUtc.ToString("dd/MM/yyyy HH:mm") UTC · <span class="estado-admin estado-@Model.Estado.ToString().ToLowerInvariant()">@Model.EstadoTexto</span></p></div>
@if (TempData["Error"] != null) { <p class="alert alert-danger" role="alert">@TempData["Error"]</p> } @if (TempData["Exito"] != null) { <p class="alert alert-success" role="status">@TempData["Exito"]</p> }
<div class="admin-detalle-grid"><div class="admin-columna"><section class="admin-panel"><div class="admin-panel-cabecera"><div><p class="etiqueta">COMPRA</p><h2>Libros del pedido</h2><p>Los precios corresponden al momento de la compra.</p></div></div>@foreach (var detalle in Model.Detalles) { <div class="admin-linea-libro"><span><strong>@detalle.Titulo</strong><small>@(detalle.Formato == FormatoLibro.Ebook ? "Formato digital" : $"Existencias actuales: {detalle.Libro.Stock}")</small></span><span>@detalle.Cantidad × @Dinero(detalle.PrecioUnitario)<strong>@Dinero(detalle.Subtotal)</strong></span></div> }</section>
<section class="admin-panel"><div class="admin-panel-cabecera"><div><p class="etiqueta">EVALUACIÓN</p><h2>Revisión del pedido</h2><p>Resultado de las reglas aplicadas al crear la compra.</p></div><span class="admin-icono"><i data-lucide="shield-check"></i></span></div>@if (Model.MotivosRevision != null) { <p><strong>Tipo:</strong> @(Model.TipoRevision == TipoRevisionPedido.Ninguna ? "Histórica" : Model.TipoRevision.ToString()) · <strong>Prioridad:</strong> @(Model.AltaPrioridad ? "Alta" : "Revisión")</p><p class="alert alert-warning">@Model.MotivosRevision</p><p>@(Model.Revisado ? "Revisión registrada." : "Revisión pendiente de validación.")</p> } else { <p>No se detectaron alertas al crear el pedido.</p> }</section></div>
<aside class="admin-columna"><section class="admin-panel"><p class="etiqueta">CLIENTE</p><h2>@Model.Usuario.NombreCompleto</h2><p>@Model.Usuario.Email<br />@(Model.Usuario.PhoneNumber ?? "Sin teléfono registrado")</p>@if (enlaceWhatsapp != null) { <a href="@enlaceWhatsapp" target="_blank" rel="noopener noreferrer">Contactar por WhatsApp ↗</a> }</section>
<section class="admin-panel"><p class="etiqueta">PAGO SIMULADO</p><h2>@(Model.MetodoPago == MetodoPagoSimulado.TarjetaSimulada ? "Tarjeta simulada" : "Transferencia simulada")</h2><p>Estado: @(Model.EstadoPago == EstadoPago.NoRegistrado ? "No registrado en pedidos históricos" : Model.EstadoPago.ToString())<br />Resultado: @(Model.ResultadoPago == ResultadoPago.NoRegistrado ? "No registrado" : Model.ResultadoPago.ToString())</p>@if (Model.TitularTarjeta != null) { <p>Titular: @Model.TitularTarjeta</p> } @if (Model.UltimosCuatro != null) { <p>Terminación: •••• @Model.UltimosCuatro</p> }</section>
<section class="admin-panel"><p class="etiqueta">IMPORTE</p><h2>Resumen</h2><dl class="admin-importes"><div><dt>Subtotal</dt><dd>@Dinero(Model.Subtotal)</dd></div><div><dt>Descuento por volumen</dt><dd>−@Dinero(Model.DescuentoVolumen)</dd></div><div><dt>Descuento institucional</dt><dd>−@Dinero(Model.DescuentoInstitucional)</dd></div><div><dt>IVA</dt><dd>@Dinero(Model.Impuesto)</dd></div><div><dt>Total</dt><dd>@Dinero(Model.Total)</dd></div></dl></section></aside></div>
<section class="admin-panel admin-acciones-detalle"><h2>Acciones del pedido</h2><div class="acciones-pedido">
@if (Model.Estado == EstadoPedido.EnRevision && !Model.Revisado) { <form asp-action="MarcarRevisado" method="post" onsubmit="return confirm('¿Confirmas que verificaste las alertas de este pedido?')"><input type="hidden" name="id" value="@Model.Id" /><button class="boton" type="submit">Marcar como revisado</button></form> }
@if (Model.Estado == EstadoPedido.Pendiente || (Model.Estado == EstadoPedido.EnRevision && Model.Revisado)) { <form asp-action="CambiarEstado" method="post" onsubmit="return confirm('¿Aprobar el pedido y descontar las existencias?')"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="estado" value="Aprobado" /><button class="boton" type="submit">Aprobar pedido</button></form> }
@if (Model.Estado == EstadoPedido.Pendiente || Model.Estado == EstadoPedido.EnRevision) { <form asp-action="CambiarEstado" method="post" onsubmit="return confirm('¿Cancelar este pedido?')"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="estado" value="Cancelado" /><button class="boton-peligro" type="submit">Cancelar pedido</button></form><form asp-action="CambiarEstado" method="post" onsubmit="return confirm('¿Cancelar este pedido por seguridad?')"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="estado" value="CanceladoPorSeguridad" /><button class="boton-peligro" type="submit">Cancelar por seguridad</button></form> }
@if (Model.Estado == EstadoPedido.Aprobado) { <form asp-action="CambiarEstado" method="post" onsubmit="return confirm('¿Marcar este pedido como enviado?')"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="estado" value="Enviado" /><button class="boton" type="submit">Marcar enviado</button></form> }</div></section></section>
