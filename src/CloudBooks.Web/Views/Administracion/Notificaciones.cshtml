@model List<CloudBooks.Web.Modelos.NotificacionPedido>
@{ ViewData["Title"] = "Avisos"; }
<section class="container pagina"><div class="admin-pagina-encabezado"><p class="etiqueta">CENTRO DE ATENCIÓN</p><h1>Avisos</h1><p>Últimos avisos internos de pedidos que requieren atención.</p><a asp-controller="AdministracionCorreos" asp-action="Index">Consultar historial de correos →</a></div><section class="admin-panel">
@if (Model.Count == 0) { <div class="admin-vacio"><i data-lucide="bell"></i><strong>No hay avisos por ahora</strong><span>Las revisiones de pedidos aparecerán aquí.</span></div> } else { <div class="admin-actividad">@foreach (var aviso in Model) { <div><a asp-action="DetallePedido" asp-route-id="@aviso.PedidoId"><strong>@aviso.Pedido.Codigo · @aviso.Pedido.Usuario.NombreCompleto</strong> — @aviso.Mensaje · @aviso.FechaUtc.ToString("dd/MM/yyyy HH:mm") UTC</a> <span>@(aviso.Leida ? "Leído" : "Pendiente")</span> @if (!aviso.Leida) { <form asp-action="LeerAviso" method="post"><input type="hidden" name="id" value="@aviso.Id" /><button type="submit">Marcar leído</button></form> }</div> }</div> }
</section><section class="admin-panel"><h2>Instituciones y actividad comercial</h2>
@foreach (var aviso in (List<CloudBooks.Web.Modelos.AvisoAdministrativo>)ViewBag.AvisosGenerales) { var partes = aviso.ClaveEvento.Split('/'); var controlador = partes[0] switch { "institucion" => "AdministracionInstituciones", "solicitud" => "AdministracionSolicitudes", "cotizacion" => "Cotizaciones", _ => "Administracion" }; var idReferencia = partes.Length > 1 && int.TryParse(partes[1], out var id) ? id : 0; <div><strong>@aviso.Titulo</strong><p>@aviso.Mensaje · @aviso.Referencia · @aviso.FechaUtc.ToString("dd/MM/yyyy HH:mm") UTC</p><a asp-controller="@controlador" asp-action="Detalle" asp-route-id="@idReferencia">Abrir detalle</a> <span>@(aviso.Leido ? "Leído" : "Pendiente")</span> @if (!aviso.Leido) { <form asp-action="LeerAvisoGeneral" method="post"><input type="hidden" name="id" value="@aviso.Id" /><button type="submit">Marcar leído</button></form> }</div> }
</section></section>
