@model List<CloudBooks.Web.Modelos.Libro>
@{ ViewData["Title"] = "Administrar catálogo"; }
<section class="container pagina"><a asp-controller="Administracion" asp-action="Index">← Administración</a><h1>Catálogo</h1>
@if (TempData["Exito"] != null) { <p class="alert alert-success" role="status">@TempData["Exito"]</p> }
<div class="acciones-pedido"><a class="boton" asp-action="Crear">Crear libro</a><a asp-controller="AdministracionCatalogos" asp-action="Index">Autores, categorías y editoriales</a></div>
<form method="get" class="filtro-estado"><label for="buscar">Buscar título o ISBN</label><input id="buscar" name="buscar" value="@Context.Request.Query["buscar"]" /><label for="estado">Estado</label><select id="estado" name="estado"><option value="">Todos</option><option value="activos" selected="@(Context.Request.Query["estado"] == "activos")">Activos</option><option value="inactivos" selected="@(Context.Request.Query["estado"] == "inactivos")">Inactivos</option></select><button type="submit">Buscar</button></form>
<div class="tabla-responsive"><table class="tabla-pedidos"><thead><tr><th>Libro</th><th>Autor</th><th>ISBN</th><th>Categoría</th><th>Formato</th><th>Precio</th><th>Stock</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@foreach (var libro in Model) { <tr><td><div class="admin-libro"><img src="@libro.ImagenPortada" alt="Portada de @libro.Titulo" /><span>@libro.Titulo @if (libro.Destacado) { <span class="admin-etiqueta">Destacado</span> }</span></div></td><td>@string.Join(", ", libro.Autores.Select(a => a.Nombre))</td><td>@libro.ISBN</td><td>@libro.Categoria.Nombre</td><td>@(libro.Formato == CloudBooks.Web.Modelos.FormatoLibro.Ebook ? "E-book" : libro.Formato == CloudBooks.Web.Modelos.FormatoLibro.TapaDura ? "Tapa dura" : "Tapa blanda")</td><td>Q@(libro.PrecioBase.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))</td><td>@(libro.Formato == CloudBooks.Web.Modelos.FormatoLibro.Ebook ? "Digital" : libro.Stock.ToString())</td><td>@(libro.Activo ? "Activo" : "Inactivo")</td><td><a asp-action="Detalle" asp-route-id="@libro.Id">Ver</a> · <a asp-action="Editar" asp-route-id="@libro.Id">Editar</a><form asp-action="CambiarEstado" method="post" onsubmit="return confirm('¿Cambiar el estado de este libro?')"><input type="hidden" name="id" value="@libro.Id" /><input type="hidden" name="activo" value="@(libro.Activo ? "false" : "true")" /><button class="@(libro.Activo ? "accion-peligro" : "accion-secundaria")" type="submit">@(libro.Activo ? "Desactivar" : "Reactivar")</button></form></td></tr> }
</tbody></table></div>@if (Model.Count == 0) { <p class="estado-vacio">No hay libros que coincidan con la búsqueda.</p> }</section>
