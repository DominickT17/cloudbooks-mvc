@model List<CloudBooks.Web.Modelos.Libro>
@using CloudBooks.Web.Modelos
@{ ViewData["Title"] = "Catálogo"; }
<section class="container pagina">
    <div class="admin-pagina-encabezado admin-bloque-cabecera"><div><p class="etiqueta">OPERACIONES · LIBRERÍA</p><h1>Catálogo</h1><p>Organiza los títulos disponibles y mantén al día su información comercial.</p></div><div class="acciones-pedido"><a class="boton-secundario" asp-controller="AdministracionCatalogos" asp-action="Index">Autores y categorías</a><a class="boton" asp-action="Crear"><i data-lucide="plus"></i> Nuevo libro</a></div></div>
    @if (TempData["Exito"] != null) { <p class="alert alert-success" role="status">@TempData["Exito"]</p> }
    <div class="admin-metrica-fila" aria-label="Resumen de resultados"><article><span>En esta vista</span><strong>@Model.Count</strong><small>Títulos encontrados</small></article><article class="es-exito"><span>Activos</span><strong>@Model.Count(l => l.Activo)</strong><small>Disponibles en catálogo</small></article><article><span>Destacados</span><strong>@Model.Count(l => l.Destacado)</strong><small>Recomendados por CloudBooks</small></article><article><span>Digitales</span><strong>@Model.Count(l => l.Formato == FormatoLibro.Ebook)</strong><small>En formato e-book</small></article></div>
    <div class="admin-panel"><div class="admin-tabla-titulo"><div><h2>Libros</h2><p>Busca por título o ISBN y filtra el catálogo.</p></div></div>
        <form method="get" class="admin-filtros"><div><label for="buscar">Título o ISBN</label><input id="buscar" name="buscar" value="@Context.Request.Query["buscar"]" placeholder="Buscar en el catálogo" /></div><div><label for="estado">Estado</label><select id="estado" name="estado"><option value="">Todos</option><option value="activos" selected="@(Context.Request.Query["estado"] == "activos")">Activos</option><option value="inactivos" selected="@(Context.Request.Query["estado"] == "inactivos")">Inactivos</option></select></div><div><label for="formato">Formato</label><select id="formato" name="formato"><option value="">Todos</option>@foreach (var formato in Enum.GetValues<FormatoLibro>()) { <option value="@formato" selected="@(Context.Request.Query["formato"] == formato.ToString())">@(formato == FormatoLibro.Ebook ? "E-book" : formato == FormatoLibro.TapaDura ? "Tapa dura" : "Tapa blanda")</option> }</select></div><button class="boton-secundario" type="submit">Filtrar</button><a class="admin-limpiar" asp-action="Index">Limpiar</a></form>
        @if (Model.Count == 0) { <div class="admin-vacio"><i data-lucide="book-open"></i><strong>No encontramos títulos</strong><span>Prueba con otros filtros o agrega un nuevo libro.</span><a asp-action="Crear">Crear libro</a></div> } else {
        <div class="tabla-responsive" tabindex="0" aria-label="Catálogo; desplázate horizontalmente para ver todas las columnas"><table class="tabla-pedidos"><thead><tr><th>Libro</th><th>Autor y categoría</th><th>ISBN</th><th>Formato</th><th>Precio</th><th>Existencias</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
        @foreach (var libro in Model) { <tr><td><div class="admin-libro"><img src="@libro.ImagenPortada" alt="" /><span><strong>@libro.Titulo</strong>@if (libro.Destacado) { <small class="admin-etiqueta">Destacado</small> }</span></div></td><td><strong>@string.Join(", ", libro.Autores.Select(a => a.Nombre))</strong><small class="admin-texto-secundario">@libro.Categoria.Nombre</small></td><td>@libro.ISBN</td><td>@(libro.Formato == FormatoLibro.Ebook ? "E-book" : libro.Formato == FormatoLibro.TapaDura ? "Tapa dura" : "Tapa blanda")</td><td>Q@(libro.PrecioBase.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))</td><td>@(libro.Formato == FormatoLibro.Ebook ? "Digital" : libro.Stock.ToString())</td><td><span class="estado-admin @(libro.Activo ? "estado-disponible" : "estado-inactivo")">@(libro.Activo ? "Activo" : "Inactivo")</span></td><td><div class="admin-acciones-fila"><a class="admin-accion" asp-action="Detalle" asp-route-id="@libro.Id">Ver</a><a class="admin-accion" asp-action="Editar" asp-route-id="@libro.Id">Editar</a><details class="admin-mas"><summary>Más</summary><form asp-action="CambiarEstado" method="post" onsubmit="return confirm('¿Cambiar el estado de este libro?')"><input type="hidden" name="id" value="@libro.Id" /><input type="hidden" name="activo" value="@(libro.Activo ? "false" : "true")" /><button class="@(libro.Activo ? "accion-peligro" : "accion-secundaria")" type="submit">@(libro.Activo ? "Desactivar" : "Reactivar")</button></form></details></div></td></tr> }
        </tbody></table></div> }
    </div>
</section>
