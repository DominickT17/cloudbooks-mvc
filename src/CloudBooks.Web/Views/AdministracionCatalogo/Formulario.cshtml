@model CloudBooks.Web.ModelosVista.LibroAdministracionModelo
@{ ViewData["Title"] = Model.Id == 0 ? "Crear libro" : "Editar libro"; }
<section class="container pagina"><a class="admin-volver" asp-action="Index">← Volver al catálogo</a><div class="admin-pagina-encabezado"><p class="etiqueta">CATÁLOGO · FICHA</p><h1>@ViewData["Title"]</h1><p>Completa los datos de la obra y selecciona una portada disponible en CloudBooks.</p></div>
<form asp-action="Guardar" method="post" class="formulario admin-formulario-libro"><div asp-validation-summary="All" class="errores" role="alert"></div><input asp-for="Id" type="hidden" /><input asp-for="StockOriginal" type="hidden" />
    <div class="admin-form-grid"><section class="admin-panel"><p class="etiqueta">01 · IDENTIFICACIÓN</p><h2>Información de la obra</h2><div class="admin-campos-libro"><div><label asp-for="Titulo"></label><input asp-for="Titulo" /></div><div><label asp-for="ISBN"></label><input asp-for="ISBN" /></div><div class="ancho-completo"><label asp-for="Sinopsis"></label><textarea asp-for="Sinopsis" rows="5"></textarea></div><div><label asp-for="AnioEdicion"></label><input asp-for="AnioEdicion" type="number" /></div><div><label asp-for="Formato"></label><select asp-for="Formato"><option value="0">Tapa blanda</option><option value="1">Tapa dura</option><option value="2">E-book</option></select></div><div><label asp-for="PrecioBase"></label><input asp-for="PrecioBase" type="number" min="0.01" step="0.01" /></div><div><label asp-for="Stock"></label><input asp-for="Stock" type="number" min="0" /><small>Los e-books no usan stock físico.</small></div></div></section>
    <section class="admin-panel"><p class="etiqueta">02 · CLASIFICACIÓN</p><h2>Publicación y portada</h2><div class="admin-campos-libro"><div><label asp-for="EditorialId"></label><select asp-for="EditorialId"><option value="">Selecciona</option>@foreach (var editorial in Model.Editoriales) { <option value="@editorial.Id">@editorial.Nombre</option> }</select></div><div><label asp-for="CategoriaId"></label><select asp-for="CategoriaId"><option value="">Selecciona</option>@foreach (var categoria in Model.Categorias) { <option value="@categoria.Id">@categoria.Nombre</option> }</select></div><div class="ancho-completo"><label asp-for="AutoresIds">Autores (selecciona uno o más)</label><select asp-for="AutoresIds" multiple size="6">@foreach (var autor in Model.Autores) { <option value="@autor.Id">@autor.Nombre</option> }</select><small>Usa Ctrl para seleccionar varios autores.</small></div><div class="ancho-completo"><label asp-for="ImagenPortada"></label><select asp-for="ImagenPortada"><option value="">Selecciona</option>@foreach (var portada in Model.Portadas) { <option value="@portada">@System.IO.Path.GetFileName(portada)</option> }</select></div><div class="ancho-completo"><label class="recordarme"><input asp-for="Destacado" /> Recomendar en CloudBooks</label></div></div></section></div>
    <div class="admin-guardar"><p>Revisa los datos antes de guardar la ficha.</p><button class="boton" type="submit">Guardar libro</button></div>
</form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
