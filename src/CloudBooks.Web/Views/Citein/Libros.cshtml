@model List<CloudBooks.Web.Modelos.Libro>
@using CloudBooks.Web.Modelos
@{ Layout = "_LayoutCitein"; bool todos = ViewBag.Todos == true; string[] destacados = ["9786075502090", "9786073221245", "9781951693510"]; var libros = todos ? Model : destacados.Select(isbn => Model.FirstOrDefault(l => l.ISBN == isbn)).Where(l => l != null).Select(l => l!).ToList(); }
<nav class="pasos" aria-label="Progreso"><strong>01 <span>Elegir libro</span></strong><span>→</span><span>02 Confirmar</span><span>→</span><span>03 Resultado</span></nav>
<div class="titulo"><div><p class="etiqueta">UNA SELECCIÓN PARA DESCUBRIR</p><h1>Elige tu próxima lectura</h1><p>Matemáticas, física y recursos digitales para aprender.</p></div><span class="distintivo">CITEIN · 2026</span></div>
<p class="aviso-precios">Precios de demostración en quetzales. No se realizan pagos reales.</p>
@if (Model.Count == 0) { <div class="vacio">No hay libros disponibles en este momento. Solicita ayuda al expositor.</div> }
<section class="grupo" aria-label="@(todos ? "Todos los libros" : "Libros destacados")"><div class="grupo-titulo"><div><h2>@(todos ? "Todos los libros" : "Libros destacados")</h2><p>@(todos ? "Matemáticas · Física · Libros digitales" : "Tres lecturas para comenzar")</p></div><span>@libros.Count.ToString("00") TÍTULOS</span></div><div class="rejilla">
@foreach (var libro in libros) { <article class="tarjeta"><div class="portada"><img src="@libro.ImagenPortada" alt="Cubierta ilustrativa de @libro.Titulo" width="520" height="720"></div><div class="tarjeta-texto"><span class="tipo">@(libro.Formato == FormatoLibro.Ebook ? "Libro digital" : $"Libro físico · {libro.Categoria.Nombre}")</span><h3>@libro.Titulo</h3><p class="autores">@string.Join(" · ", libro.Autores.Select(a => a.Nombre).OrderBy(n => n))</p><p class="edicion">@(libro.ISBN.StartsWith("978607550") ? "4.ª edición · " : libro.ISBN == "9786073221245" ? "13.ª edición · " : "Edición en español · ")@libro.AnioEdicion</p><div class="tarjeta-pie"><div><span class="precio-label">PRECIO DEMOSTRATIVO</span><p class="precio">Q @libro.PrecioBase.ToString("N2")</p></div><form asp-action="Elegir" method="post"><input type="hidden" name="libroId" value="@libro.Id"><button class="boton secundario" type="submit" aria-label="Elegir @libro.Titulo">Elegir este libro <span aria-hidden="true">→</span></button></form></div></div></article> }
</div></section>
@if (!todos) { <a class="explorar" asp-action="Libros" asp-route-todos="1">Explorar todos los libros <span aria-hidden="true">→</span></a> } else { <a class="explorar" asp-action="Libros">← Volver a destacados</a> }
<p class="nota-licencia">Cubiertas ilustrativas, no son portadas editoriales. Los títulos de OpenStax tienen acceso gratuito en su sitio oficial; la compra simulada no entrega archivos.</p>
