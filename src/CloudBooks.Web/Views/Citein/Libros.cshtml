@model List<CloudBooks.Web.Modelos.Libro>
@using CloudBooks.Web.Modelos
@{ Layout = "_LayoutCitein"; var grupos = new[] { ("Matemáticas", "Bases para pensar y resolver", Model.Where(l => l.Formato != FormatoLibro.Ebook && l.Categoria.Nombre == "Matemáticas")), ("Física", "Explora cómo funciona el mundo", Model.Where(l => l.Formato != FormatoLibro.Ebook && l.Categoria.Nombre == "Física")), ("Libros digitales", "Recursos para seguir aprendiendo", Model.Where(l => l.Formato == FormatoLibro.Ebook)) }; }
<nav class="pasos" aria-label="Progreso"><strong>01 <span>Elegir libro</span></strong><span>→</span><span>02 Confirmar</span><span>→</span><span>03 Resultado</span></nav>
<div class="titulo"><div><p class="etiqueta">UNA SELECCIÓN PARA DESCUBRIR</p><h1>Elige tu próxima lectura</h1><p>Matemáticas, física y recursos digitales para aprender.</p></div><span class="distintivo">CITEIN · 2026</span></div>
<p class="aviso-precios">Precios de demostración en quetzales. No se realizan pagos reales.</p>
@if (Model.Count == 0) { <div class="vacio">No hay libros disponibles en este momento. Solicita ayuda al expositor.</div> }
@foreach (var (nombre, descripcion, libros) in grupos) { if (libros.Any()) { <section class="grupo" aria-label="@nombre"><div class="grupo-titulo"><div><h2>@nombre</h2><p>@descripcion</p></div><span>@libros.Count().ToString("00") TÍTULOS</span></div><div class="rejilla">@foreach (var libro in libros) { <article class="tarjeta"><div class="portada"><img src="@libro.ImagenPortada" alt="Cubierta ilustrativa de @libro.Titulo" width="520" height="720" loading="lazy"></div><div class="tarjeta-texto"><span class="tipo">@(libro.Formato == FormatoLibro.Ebook ? "Libro digital" : nombre)</span><h3>@libro.Titulo</h3><p class="autores">@string.Join(" · ", libro.Autores.Select(a => a.Nombre).OrderBy(n => n))</p><p class="edicion">@(libro.ISBN.StartsWith("978607550") ? "4.ª edición · " : libro.ISBN == "9786073221245" ? "13.ª edición · " : "Edición en español · ")@libro.AnioEdicion</p><div class="tarjeta-pie"><div><span class="precio-label">PRECIO DEMOSTRATIVO</span><p class="precio">Q @libro.PrecioBase.ToString("N2")</p></div><form asp-action="Elegir" method="post"><input type="hidden" name="libroId" value="@libro.Id"><button class="boton secundario" type="submit" aria-label="Elegir @libro.Titulo">Elegir este libro <span aria-hidden="true">→</span></button></form></div></div></article> }</div></section> } }
<p class="nota-licencia">Cubiertas ilustrativas, no son portadas editoriales. Los títulos de OpenStax tienen acceso gratuito en su sitio oficial; la compra simulada no entrega archivos.</p>
