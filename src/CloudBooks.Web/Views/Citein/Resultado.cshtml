@model CloudBooks.Web.Modelos.Pedido
@{ Layout = "_LayoutCitein"; }
<nav class="pasos" aria-label="Progreso"><span>01 Elegir libro</span><span>→</span><span>02 Confirmar</span><span>→</span><strong>03 <span>Resultado</span></strong></nav>
<section class="resultado"><div class="check" aria-hidden="true">✓</div><p class="etiqueta">DEMOSTRACIÓN COMPLETADA</p><h1>¡Tu compra simulada fue registrada!</h1><p>El administrador ya puede consultar este pedido.</p><div class="recibo"><div><span>Pedido</span><strong>@Model.Codigo</strong></div><div><span>Libro</span><strong>@Model.Detalles.First().Titulo</strong></div><div><span>Estado</span><strong>@Model.EstadoTexto</strong></div><div><span>Total</span><strong>Q @Model.Total.ToString("N2")</strong></div></div>@if (Model.Estado == CloudBooks.Web.Modelos.EstadoPedido.EnRevision) { <p>El pedido requiere revisión administrativa; las existencias aún no se han descontado.</p> }<form asp-action="Iniciar" method="post"><button class="boton" type="submit">Realizar otra demostración <span aria-hidden="true">→</span></button></form></section>
