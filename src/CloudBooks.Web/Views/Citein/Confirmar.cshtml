@model CloudBooks.Web.Controllers.ConfirmacionCitein
@using CloudBooks.Web.Modelos
@{ Layout = "_LayoutCitein"; }
<nav class="pasos" aria-label="Progreso"><span>01 Elegir libro</span><span>→</span><strong>02 <span>Confirmar</span></strong><span>→</span><span>03 Resultado</span></nav>
<div class="titulo"><div><p class="etiqueta">CASI LISTO</p><h1>Confirma tu compra</h1><p>Revisa los detalles antes de continuar.</p></div></div>
<section class="confirmacion"><div class="seleccion"><img src="@Model.Libro.ImagenPortada" alt="Cubierta ilustrativa de @Model.Libro.Titulo"><div><span class="tipo">@(Model.Libro.Formato == FormatoLibro.Ebook ? "Libro digital" : "Libro físico")</span><h2>@Model.Libro.Titulo</h2><p>@string.Join(" · ", Model.Libro.Autores.Select(a => a.Nombre).OrderBy(n => n))</p><p>Cantidad: 1 ejemplar</p>@if (Model.Libro.Formato == FormatoLibro.Ebook) { <p class="aclaracion">Compra simulada: no se entrega ni descarga un archivo. El texto está disponible gratis en el sitio oficial de OpenStax.</p> }</div></div><div class="resumen"><h2>Resumen</h2><div><span>Subtotal</span><span>Q @Model.Resumen.Subtotal.ToString("N2")</span></div><div><span>Descuento</span><span>− Q @Model.Resumen.DescuentoVolumen.ToString("N2")</span></div><div><span>IVA</span><span>Q @Model.Resumen.Impuesto.ToString("N2")</span></div><div class="total"><span>Total</span><span>Q @Model.Resumen.Total.ToString("N2")</span></div><form asp-action="Comprar" method="post" data-compra data-estado-url="@Url.Action("EstadoCompra")"><button class="boton" type="submit">Confirmar compra simulada <span aria-hidden="true">→</span></button><p class="estado-compra" role="status" aria-live="polite"></p><button class="comprobar-estado" type="button" hidden>Comprobar estado de la compra</button></form><a class="volver" asp-action="Libros">← Cambiar de libro</a><p class="nota">Precio de demostración. No se solicita tarjeta ni se realizan pagos reales.</p></div></section>
