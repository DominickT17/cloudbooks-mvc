@model CloudBooks.Web.Controllers.ConfirmacionCitein
@{ Layout = "_LayoutCitein"; }
<nav class="pasos" aria-label="Progreso"><span>01 Elegir libro</span><span>→</span><strong>02 <span>Confirmar</span></strong><span>→</span><span>03 Resultado</span></nav>
<div class="titulo"><p class="etiqueta">CASI LISTO</p><h1>Confirma tu compra</h1><p>Revisa los detalles antes de continuar.</p></div>
<section class="confirmacion"><div class="seleccion"><img src="@Model.Libro.ImagenPortada" alt="Portada de @Model.Libro.Titulo"><div><span class="etiqueta">TU ELECCIÓN</span><h2>@Model.Libro.Titulo</h2><p>Cantidad: 1 ejemplar</p></div></div><div class="resumen"><h2>Resumen</h2><div><span>Subtotal</span><span>Q @Model.Resumen.Subtotal.ToString("N2")</span></div><div><span>Descuento</span><span>− Q @Model.Resumen.DescuentoVolumen.ToString("N2")</span></div><div><span>IVA</span><span>Q @Model.Resumen.Impuesto.ToString("N2")</span></div><div class="total"><span>Total</span><span>Q @Model.Resumen.Total.ToString("N2")</span></div><form asp-action="Comprar" method="post"><button class="boton" type="submit">Realizar compra simulada <span aria-hidden="true">→</span></button></form><a class="volver" asp-action="Libros">← Cambiar de libro</a><p class="nota">Pago académico simulado. No se solicita tarjeta.</p></div></section>
