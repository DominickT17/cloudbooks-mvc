@{ Layout = "_LayoutAdministracion"; ViewData["Title"] = "Monitor CITEIN"; }
<link rel="stylesheet" href="~/css/citein-monitor.css" asp-append-version="true">
<div class="monitor-citein">
 <header class="monitor-cabecera"><div class="monitor-marca"><img src="~/imagenes/marca/cloudbooks.png" asp-append-version="true" alt="CloudBooks" width="1448" height="1086"><div><p>CITEIN 2026 · UNIVERSIDAD MESOAMERICANA</p><h1>CloudBooks <span>— Monitor de compras CITEIN</span></h1></div></div><button type="button" class="monitor-modo" id="modo-presentacion">Modo presentación</button></header>
 <section class="monitor-indicadores" aria-label="Estado de la demostración"><div><span>Pedidos de demostración</span><strong id="total-pedidos">—</strong><small>Registrados en SQL Server</small></div><div><span>Último pedido recibido</span><strong id="ultimo-codigo">—</strong><small>Experiencia CITEIN</small></div><div><span>Conexión del monitor</span><strong id="conexion" data-estado="espera">Conectando</strong><small>Consulta automática</small></div><div><span>Última actualización</span><strong id="ultima-actualizacion">—</strong><small>Hora de Guatemala</small></div></section>
 <div id="aviso-monitor" class="monitor-aviso" role="status" aria-live="polite"></div>
 <div class="monitor-contenido"><section class="monitor-panel monitor-ultimo" id="panel-ultimo" aria-labelledby="titulo-ultimo"><div class="monitor-titulo"><div><p>OPERACIÓN EN VIVO</p><h2 id="titulo-ultimo">Último pedido recibido</h2></div><span class="monitor-en-vivo">CITEIN</span></div><div id="monitor-detalle" class="monitor-vacio">Consultando pedidos…</div></section>
 <section class="monitor-panel monitor-historial" aria-labelledby="titulo-historial"><div class="monitor-titulo"><div><p>ACTIVIDAD RECIENTE</p><h2 id="titulo-historial">Últimos cinco pedidos CITEIN</h2></div></div><div id="historial-pedidos" class="monitor-lista"><p class="monitor-vacio">Consultando historial…</p></div><a class="monitor-enlace" asp-controller="Administracion" asp-action="Pedidos">Ver todos los pedidos en Administración →</a></section></div>
</div>
@section Scripts { <script src="~/js/citein-monitor.js" asp-append-version="true"></script> }
