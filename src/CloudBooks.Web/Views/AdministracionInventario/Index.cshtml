@model List<CloudBooks.Web.Modelos.Libro>
@using CloudBooks.Web.Modelos
@{ ViewData["Title"] = "Inventario"; var umbral = (int)ViewBag.Umbral; var resumen = (List<Libro>)ViewBag.Resumen; }
<section class="container pagina"><div class="admin-pagina-encabezado"><p class="etiqueta">OPERACIONES · EXISTENCIAS</p><h1>Inventario</h1><p>Consulta la disponibilidad y actualiza las existencias de cada título físico.</p></div>
@if (TempData["Error"] != null) { <p class="alert alert-danger" role="alert">@TempData["Error"]</p> } @if (TempData["Exito"] != null) { <p class="alert alert-success" role="status">@TempData["Exito"]</p> }
<div class="admin-metrica-fila admin-metricas-enlace" aria-label="Resumen de inventario para la búsqueda actual">
<a asp-action="Index" asp-route-buscar="@Context.Request.Query["buscar"]" asp-route-tipo="disponibles"><span>Disponibles</span><strong>@resumen.Count(l => l.Formato != FormatoLibro.Ebook && l.Stock > umbral)</strong><small>Por encima del umbral</small></a>
<a class="es-atencion" asp-action="Index" asp-route-buscar="@Context.Request.Query["buscar"]" asp-route-tipo="bajo"><span>Stock bajo</span><strong>@resumen.Count(l => l.Formato != FormatoLibro.Ebook && l.Stock > 0 && l.Stock <= umbral)</strong><small>Hasta @umbral unidades</small></a>
<a class="es-peligro" asp-action="Index" asp-route-buscar="@Context.Request.Query["buscar"]" asp-route-tipo="agotados"><span>Agotados</span><strong>@resumen.Count(l => l.Formato != FormatoLibro.Ebook && l.Stock == 0)</strong><small>Sin unidades físicas</small></a>
<a asp-action="Index" asp-route-buscar="@Context.Request.Query["buscar"]" asp-route-tipo="digitales"><span>E-books</span><strong>@resumen.Count(l => l.Formato == FormatoLibro.Ebook)</strong><small>Sin stock físico</small></a></div>
<div class="admin-panel"><div class="admin-tabla-titulo"><div><h2>Existencias por libro</h2><p>Los indicadores reflejan la búsqueda actual, incluidos títulos inactivos.</p></div></div>
<form method="get" class="admin-filtros"><div><label for="buscar">Título o ISBN</label><input id="buscar" name="buscar" value="@Context.Request.Query["buscar"]" placeholder="Buscar un libro" /></div><div><label for="tipo">Disponibilidad</label><select id="tipo" name="tipo"><option value="">Todos</option><option value="disponibles" selected="@(Context.Request.Query["tipo"] == "disponibles")">Disponibles</option><option value="bajo" selected="@(Context.Request.Query["tipo"] == "bajo")">Stock bajo</option><option value="agotados" selected="@(Context.Request.Query["tipo"] == "agotados")">Agotados</option><option value="digitales" selected="@(Context.Request.Query["tipo"] == "digitales")">E-books</option></select></div><button class="boton-secundario" type="submit">Filtrar</button><a class="admin-limpiar" asp-action="Index">Limpiar</a></form>
@if (Model.Count == 0) { <div class="admin-vacio"><i data-lucide="boxes"></i><strong>No encontramos libros</strong><span>Ajusta la búsqueda o el filtro de disponibilidad.</span><a asp-action="Index">Ver todo el inventario</a></div> } else {
<div class="tabla-responsive" tabindex="0" aria-label="Inventario; desplázate horizontalmente para ver todas las columnas"><table class="tabla-pedidos"><thead><tr><th>Libro</th><th>Formato</th><th>Disponibilidad</th><th>Actual</th><th>Actualizar existencias</th></tr></thead><tbody>
@foreach (var libro in Model) { var estado = libro.Formato == FormatoLibro.Ebook ? "Digital" : libro.Stock == 0 ? "Agotado" : libro.Stock <= umbral ? "Stock bajo" : "Disponible"; var clase = libro.Formato == FormatoLibro.Ebook ? "digital" : libro.Stock == 0 ? "sin-existencias" : libro.Stock <= umbral ? "stock-bajo" : "disponible"; <tr><td><div class="admin-libro"><img src="@libro.ImagenPortada" alt="" /><span><strong>@libro.Titulo</strong><small class="admin-texto-secundario">@libro.ISBN @(libro.Activo ? "" : "· Inactivo")</small></span></div></td><td>@(libro.Formato == FormatoLibro.Ebook ? "E-book" : libro.Formato == FormatoLibro.TapaDura ? "Tapa dura" : "Tapa blanda")</td><td><span class="estado-admin estado-@clase">@estado</span></td><td><strong>@(libro.Formato == FormatoLibro.Ebook ? "—" : libro.Stock.ToString())</strong></td><td>@if (libro.Formato != FormatoLibro.Ebook) { <form asp-action="Actualizar" method="post" class="admin-stock-form"><input type="hidden" name="id" value="@libro.Id" /><input type="hidden" name="stockOriginal" value="@libro.Stock" /><label for="stock-@libro.Id">Nuevo stock de @libro.Titulo</label><div><input id="stock-@libro.Id" type="number" name="stockNuevo" min="0" max="1000000" value="@libro.Stock" required /><button type="submit" aria-label="Guardar existencias de @libro.Titulo">Guardar</button></div></form> } else { <span class="admin-texto-secundario">No requiere existencias</span> }</td></tr> }
</tbody></table></div> }</div></section>
