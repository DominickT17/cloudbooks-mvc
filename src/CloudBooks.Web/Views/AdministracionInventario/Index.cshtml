@model List<CloudBooks.Web.Modelos.Libro>
@using CloudBooks.Web.Modelos
@using CloudBooks.Web.Servicios
@{ ViewData["Title"] = "Inventario"; }
<section class="container pagina"><a asp-controller="Administracion" asp-action="Index">← Administración</a><h1>Inventario</h1>
@if (TempData["Error"] != null) { <p class="alert alert-danger" role="alert">@TempData["Error"]</p> } @if (TempData["Exito"] != null) { <p class="alert alert-success" role="status">@TempData["Exito"]</p> }
<form method="get" class="filtro-estado"><label for="buscar">Título o ISBN</label><input id="buscar" name="buscar" value="@Context.Request.Query["buscar"]" /><button type="submit">Buscar</button></form>
<div class="tabla-responsive"><table class="tabla-pedidos"><thead><tr><th>Libro</th><th>Formato</th><th>Disponibilidad</th><th>Existencias</th><th>Actualizar</th></tr></thead><tbody>
@foreach (var libro in Model) { <tr><td><div class="admin-libro"><img src="@libro.ImagenPortada" alt="Portada de @libro.Titulo" /><span>@libro.Titulo @(libro.Activo ? "" : "(inactivo)")</span></div></td><td>@(libro.Formato == FormatoLibro.Ebook ? "E-book" : libro.Formato == FormatoLibro.TapaDura ? "Tapa dura" : "Tapa blanda")</td><td>@{ var estadoInventario = libro.Formato == FormatoLibro.Ebook ? "Digital" : libro.Stock == 0 ? "Sin existencias" : libro.Stock <= (int)ViewBag.Umbral ? "Stock bajo" : "Disponible"; var claseEstado = libro.Formato == FormatoLibro.Ebook ? "digital" : libro.Stock == 0 ? "sin-existencias" : libro.Stock <= (int)ViewBag.Umbral ? "stock-bajo" : "disponible"; }<span class="estado-admin estado-@claseEstado">@estadoInventario</span></td><td>@(libro.Formato == FormatoLibro.Ebook ? "—" : libro.Stock.ToString())</td><td>@if (libro.Formato != FormatoLibro.Ebook) { <form asp-action="Actualizar" method="post" class="filtro-estado"><input type="hidden" name="id" value="@libro.Id" /><input type="hidden" name="stockOriginal" value="@libro.Stock" /><label for="stock-@libro.Id">Nuevo stock</label><input id="stock-@libro.Id" type="number" name="stockNuevo" min="0" max="1000000" value="@libro.Stock" required /><button type="submit">Actualizar</button></form> }</td></tr> }
</tbody></table></div>@if (Model.Count == 0) { <p class="estado-vacio">No encontramos libros para esta búsqueda.</p> }</section>
