@model CloudBooks.Web.Modelos.ParametrosSistema
@{ ViewData["Title"] = "Configuración"; }
<section class="container pagina"><div class="admin-pagina-encabezado"><div><p class="etiqueta">PREFERENCIAS DEL SISTEMA</p><h1>Configuración</h1><p>Ajusta las reglas comerciales y de inventario para las nuevas operaciones.</p></div></div>
@if (TempData["Exito"] != null) { <p class="alert alert-success" role="status">@TempData["Exito"]</p> }
<form asp-action="Guardar" method="post" class="admin-configuracion"><div asp-validation-summary="All" class="errores" role="alert"></div>
<section class="admin-panel admin-config-card"><div><span class="admin-icono"><i data-lucide="badge-percent"></i></span><h2>Comercial</h2><p>Define los importes y plazos de nuevas compras y cotizaciones.</p></div><div class="admin-campos"><div><label asp-for="TasaImpuesto"></label><input asp-for="TasaImpuesto" type="number" min="0" max="1" step="0.0001" /><small>0.12 equivale al 12 %.</small></div><div><label asp-for="DiasVigencia"></label><input asp-for="DiasVigencia" type="number" min="1" max="365" /><small>Plazo de las cotizaciones nuevas.</small></div></div></section>
<section class="admin-panel admin-config-card"><div><span class="admin-icono"><i data-lucide="boxes"></i></span><h2>Inventario</h2><p>Identifica productos que pueden necesitar reposición.</p></div><div class="admin-campos"><div><label asp-for="UmbralStockBajo"></label><input asp-for="UmbralStockBajo" type="number" min="0" max="1000000" /><small>Existencias físicas iguales o inferiores a este valor.</small></div><div><label asp-for="PorcentajeRevisionInventario"></label><input asp-for="PorcentajeRevisionInventario" type="number" min="1" max="100" /><small>Se revisa si además el stock restante queda bajo el umbral.</small></div></div></section>
<section class="admin-panel admin-config-card"><div><span class="admin-icono"><i data-lucide="shield-check"></i></span><h2>Revisión de pedidos</h2><p>Establece cuándo una operación requiere atención comercial.</p></div><div class="admin-campos"><div><label asp-for="MontoRevision"></label><input asp-for="MontoRevision" type="number" min="0.01" max="1000000000" step="0.01" /><small>Se revisan los pedidos que superan este monto.</small></div><div><label asp-for="CantidadRevisionMinorista"></label><input asp-for="CantidadRevisionMinorista" type="number" min="1" max="1000000" /><small>Unidades de un mismo título para clientes minoristas.</small></div></div></section>
<div class="admin-guardar"><p>Los pedidos y cotizaciones anteriores conservan sus importes y vigencia.</p><button type="submit" class="boton">Guardar configuración</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
