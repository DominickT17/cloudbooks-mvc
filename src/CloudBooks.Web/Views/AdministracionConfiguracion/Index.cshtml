@model CloudBooks.Web.Modelos.ParametrosSistema
@inject CloudBooks.Web.Servicios.IProveedorCorreo ProveedorCorreo
@{ ViewData["Title"] = "Configuración"; var real = ProveedorCorreo is CloudBooks.Web.Servicios.ProveedorCorreoResend; }
<section class="container pagina"><div class="admin-pagina-encabezado"><p class="etiqueta">GESTIÓN · PARÁMETROS</p><h1>Configuración</h1><p>Define las reglas de las nuevas operaciones y consulta el estado de las comunicaciones.</p></div>
@if (TempData["Exito"] != null) { <p class="alert alert-success" role="status">@TempData["Exito"]</p> }
<form asp-action="Guardar" method="post" class="admin-configuracion"><div asp-validation-summary="All" class="errores" role="alert"></div>
<div class="admin-config-cuadricula">
<section class="admin-panel admin-config-bloque"><div class="admin-config-titulo"><span class="admin-icono"><i data-lucide="badge-percent"></i></span><div><h2>Comercial</h2><p>Impuestos y vigencia de nuevas cotizaciones.</p></div></div><div class="admin-campos"><div><label asp-for="TasaImpuesto"></label><input asp-for="TasaImpuesto" type="number" min="0" max="1" step="0.0001" /><small>0.12 equivale al 12 %.</small><span asp-validation-for="TasaImpuesto" class="text-danger"></span></div><div><label asp-for="DiasVigencia"></label><input asp-for="DiasVigencia" type="number" min="1" max="365" /><small>Plazo para cotizaciones nuevas.</small><span asp-validation-for="DiasVigencia" class="text-danger"></span></div></div></section>
<section class="admin-panel admin-config-bloque"><div class="admin-config-titulo"><span class="admin-icono"><i data-lucide="boxes"></i></span><div><h2>Inventario</h2><p>Alertas de reposición y consumo.</p></div></div><div class="admin-campos"><div><label asp-for="UmbralStockBajo"></label><input asp-for="UmbralStockBajo" type="number" min="0" max="1000000" /><small>Unidades iguales o inferiores al umbral.</small><span asp-validation-for="UmbralStockBajo" class="text-danger"></span></div><div><label asp-for="PorcentajeRevisionInventario"></label><input asp-for="PorcentajeRevisionInventario" type="number" min="1" max="100" /><small>También requiere que el stock restante sea bajo.</small><span asp-validation-for="PorcentajeRevisionInventario" class="text-danger"></span></div></div></section>
<section class="admin-panel admin-config-bloque"><div class="admin-config-titulo"><span class="admin-icono"><i data-lucide="shield-check"></i></span><div><h2>Pedidos</h2><p>Condiciones para revisión comercial.</p></div></div><div class="admin-campos"><div><label asp-for="MontoRevision"></label><input asp-for="MontoRevision" type="number" min="0.01" max="1000000000" step="0.01" /><small>Se revisan pedidos que superan este monto.</small><span asp-validation-for="MontoRevision" class="text-danger"></span></div><div><label asp-for="CantidadRevisionMinorista"></label><input asp-for="CantidadRevisionMinorista" type="number" min="1" max="1000000" /><small>Unidades de un título para minoristas.</small><span asp-validation-for="CantidadRevisionMinorista" class="text-danger"></span></div></div></section>
<section class="admin-panel admin-config-bloque"><div class="admin-config-titulo"><span class="admin-icono"><i data-lucide="mail-check"></i></span><div><h2>Comunicaciones</h2><p>Estado de la cola de correo transaccional.</p></div></div><div class="admin-correo-estado"><span class="estado-admin @(real ? "estado-stock-bajo" : "estado-disponible")">@(real ? "Resend · envío real" : "Simulado · sin envío externo")</span><p>La selección del proveedor y sus credenciales se gestionan fuera de esta pantalla.</p><a class="admin-accion" asp-controller="AdministracionCorreos" asp-action="Index">Ver historial de correos →</a></div></section>
</div><div class="admin-guardar"><p>Los pedidos y cotizaciones anteriores conservan sus importes y vigencia.</p><button type="submit" class="boton">Guardar configuración</button></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
