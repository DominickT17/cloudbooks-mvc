@model CloudBooks.Web.Modelos.ParametrosSistema
@{ ViewData["Title"] = "Configuración"; }
<section class="container pagina"><a asp-controller="Administracion" asp-action="Index">← Administración</a><h1>Configuración</h1><p>Los cambios afectan operaciones nuevas; pedidos y cotizaciones anteriores conservan sus importes y vigencia.</p>
@if (TempData["Exito"] != null) { <p class="alert alert-success" role="status">@TempData["Exito"]</p> }
<form asp-action="Guardar" method="post" class="formulario formulario-institucional"><div asp-validation-summary="All" class="errores" role="alert"></div>
<label asp-for="TasaImpuesto"></label><input asp-for="TasaImpuesto" type="number" min="0" max="1" step="0.0001" /><small>Por ejemplo, 0.12 equivale al 12 %.</small>
<label asp-for="UmbralStockBajo"></label><input asp-for="UmbralStockBajo" type="number" min="0" max="1000000" /><small>Los libros físicos con esta cantidad o menos aparecen con stock bajo.</small>
<label asp-for="DiasVigencia"></label><input asp-for="DiasVigencia" type="number" min="1" max="365" /><small>Determina el plazo de respuesta de las cotizaciones nuevas.</small>
<button type="submit" class="boton">Guardar parámetros</button></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
