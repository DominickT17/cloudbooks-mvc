@model CloudBooks.Web.Modelos.SolicitudCotizacion
<p>Estado: <strong>@Model.Estado</strong> · @(Model.Asesor?.NombreCompleto ?? "Pendiente de asignación")</p><dl class="ficha"><div><dt>Institución</dt><dd>@Model.PerfilInstitucional.Institucion</dd></div><div><dt>NIT</dt><dd>@Model.PerfilInstitucional.Nit</dd></div><div><dt>Representante</dt><dd>@Model.PerfilInstitucional.Representante</dd></div><div><dt>Obra</dt><dd>@Model.Titulo</dd></div><div><dt>Cantidad</dt><dd>@Model.Cantidad</dd></div><div><dt>Acabado</dt><dd>@Model.Acabado</dd></div><div><dt>Papel</dt><dd>@Model.Papel</dd></div><div><dt>Fecha requerida</dt><dd>@Model.FechaRequerida.ToString("dd/MM/yyyy")</dd></div><div><dt>Observaciones</dt><dd>@(Model.Observaciones ?? "—")</dd></div></dl>
