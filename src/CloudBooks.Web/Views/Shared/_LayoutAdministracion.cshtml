@{ var nombre = User.Identity?.Name ?? "Administrador"; var inicial = nombre.Length > 0 ? nombre.Substring(0, 1).ToUpperInvariant() : "A"; }
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] - Administración CloudBooks</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/cloudbooks.css" asp-append-version="true" /><link rel="stylesheet" href="~/css/administracion.css" asp-append-version="true" /></head>
<body class="admin-cuerpo"><div class="admin-estructura"><aside class="admin-lateral">
<a class="admin-identidad" asp-controller="Administracion" asp-action="Index"><img src="~/imagenes/marca/cloudbooks.png" alt="CloudBooks" /><span><strong>CloudBooks</strong><small>Centro de administración</small></span></a>
<div class="admin-etiqueta-menu">ESPACIO DE TRABAJO</div><details class="admin-menu" open><summary>Menú administrativo</summary>@await Component.InvokeAsync("MenuAdministracion")</details>
<div class="admin-perfil-lateral"><span class="admin-avatar">@inicial</span><span><small>Administrador</small><strong>@nombre</strong></span></div>
</aside><div class="admin-area"><header class="admin-superior"><div class="admin-ruta"><span>CloudBooks / Administración</span><strong>@ViewData["Title"]</strong></div><div class="admin-cuenta"><a class="admin-campana" asp-controller="Administracion" asp-action="Notificaciones" aria-label="Avisos administrativos"><i data-lucide="bell"></i></a><a class="admin-avatar" asp-controller="Cuenta" asp-action="Index" aria-label="Mi cuenta">@inicial</a><details class="admin-cuenta-menu"><summary>Mi cuenta</summary><div><a asp-controller="Cuenta" asp-action="Index">Ver mi cuenta</a><form asp-controller="Cuenta" asp-action="Salir" method="post"><button class="enlace-boton" type="submit">Cerrar sesión</button></form></div></details></div></header><main>@RenderBody()</main></div></div>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/lib/lucide/umd/lucide.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
