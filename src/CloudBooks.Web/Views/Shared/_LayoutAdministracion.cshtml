@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var accion = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Activo(bool condicion) => condicion ? "activo" : "";
}
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] - Administración CloudBooks</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/cloudbooks.css" asp-append-version="true" /></head>
<body class="admin-cuerpo"><div class="admin-estructura"><aside class="admin-lateral"><div class="admin-marca"><a asp-controller="Inicio" asp-action="Index"><img src="~/imagenes/marca/cloudbooks.png" alt="CloudBooks" /></a><span>Administración</span></div><details class="admin-menu" open><summary>Menú administrativo</summary><nav aria-label="Administración">
<a class="@Activo(controlador == "Administracion" && accion == "Index")" asp-controller="Administracion" asp-action="Index"><i data-lucide="layout-dashboard"></i> Dashboard</a>
<a class="@Activo(controlador.StartsWith("AdministracionCatalogo"))" asp-controller="AdministracionCatalogo" asp-action="Index"><i data-lucide="book-open"></i> Catálogo</a>
<a class="@Activo(controlador == "AdministracionInventario")" asp-controller="AdministracionInventario" asp-action="Index"><i data-lucide="boxes"></i> Inventario</a>
<a class="@Activo(controlador == "Administracion" && accion != "Index")" asp-controller="Administracion" asp-action="Pedidos"><i data-lucide="shopping-bag"></i> Pedidos</a>
<a class="@Activo(controlador == "AdministracionInstituciones")" asp-controller="AdministracionInstituciones" asp-action="Index"><i data-lucide="building-2"></i> Instituciones</a>
<a class="@Activo(controlador == "AdministracionSolicitudes")" asp-controller="AdministracionSolicitudes" asp-action="Index"><i data-lucide="clipboard-list"></i> Solicitudes comerciales</a>
<a class="@Activo(controlador == "Cotizaciones")" asp-controller="Cotizaciones" asp-action="Administracion"><i data-lucide="file-text"></i> Cotizaciones</a>
<a class="@Activo(controlador == "AdministracionUsuarios")" asp-controller="AdministracionUsuarios" asp-action="Index"><i data-lucide="users-round"></i> Usuarios</a>
<a class="@Activo(controlador == "AdministracionConfiguracion")" asp-controller="AdministracionConfiguracion" asp-action="Index"><i data-lucide="settings"></i> Configuración</a>
<a class="volver-tienda" asp-controller="Inicio" asp-action="Index">← Volver a la tienda</a></nav></details></aside><div class="admin-area"><header class="admin-superior"><strong>@ViewData["Title"]</strong><div><a asp-controller="Cuenta" asp-action="Index">@User.Identity?.Name</a><form asp-controller="Cuenta" asp-action="Salir" method="post"><button class="enlace-boton" type="submit">Cerrar sesión</button></form></div></header><main>@RenderBody()</main></div></div>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/lib/lucide/umd/lucide.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
