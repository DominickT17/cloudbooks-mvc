<!DOCTYPE html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] - Administración CloudBooks</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/cloudbooks.css" asp-append-version="true" /></head>
<body class="admin-cuerpo"><div class="admin-estructura"><aside class="admin-lateral"><div class="admin-marca"><a asp-controller="Inicio" asp-action="Index"><img src="~/imagenes/marca/cloudbooks.png" alt="CloudBooks" /></a><span>Administración</span></div><details class="admin-menu" open><summary>Menú administrativo</summary>@await Component.InvokeAsync("MenuAdministracion")</details></aside><div class="admin-area"><header class="admin-superior"><strong>@ViewData["Title"]</strong><div><a asp-controller="Cuenta" asp-action="Index">@User.Identity?.Name</a><form asp-controller="Cuenta" asp-action="Salir" method="post"><button class="enlace-boton" type="submit">Cerrar sesión</button></form></div></header><main>@RenderBody()</main></div></div>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/lib/lucide/umd/lucide.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
