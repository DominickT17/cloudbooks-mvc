<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - CloudBooks</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/cloudbooks.css" asp-append-version="true" />
</head>
<body>
    <header class="cabecera">
        <nav class="container navegacion" aria-label="Navegación principal">
            <a asp-controller="Inicio" asp-action="Index" aria-label="CloudBooks, inicio"><img class="marca" src="~/imagenes/marca/cloudbooks.png" alt="CloudBooks" /></a>
            <div class="nav-enlaces">
                <a asp-controller="Inicio" asp-action="Index">Inicio</a>
                <a asp-controller="Catalogo" asp-action="Index">Catálogo</a>
                <a asp-controller="Inicio" asp-action="Instituciones">Instituciones</a>
                @await Component.InvokeAsync("ContadorCarrito")
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Cuenta" asp-action="Index">Mi cuenta</a>
                    <a asp-controller="Pedidos" asp-action="Index">Mis pedidos</a>
                    @if (User.IsInRole("AsesorVentas")) { <a asp-controller="Asesor" asp-action="Index">Mis solicitudes</a> }
                    @if (User.IsInRole("Administrador")) { <a asp-controller="Administracion" asp-action="Index">Administración</a> }
                    <form asp-controller="Cuenta" asp-action="Salir" method="post"><button class="enlace-boton" type="submit">Cerrar sesión</button></form>
                }
                else
                {
                    <a asp-controller="Cuenta" asp-action="Ingresar">Iniciar sesión</a>
                    <a asp-controller="Cuenta" asp-action="Registrar">Registrarse</a>
                }
            </div>
        </nav>
    </header>
    <main>@RenderBody()</main>
    <footer class="pie"><div class="container">CloudBooks · Zona 1, Quetzaltenango, Guatemala<br /><a href="mailto:dominickt1703@gmail.com">dominickt1703@gmail.com</a> · +502 5575 1509</div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
