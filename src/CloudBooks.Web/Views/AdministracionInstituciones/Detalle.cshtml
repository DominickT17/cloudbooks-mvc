@model CloudBooks.Web.Modelos.SolicitudInstitucional
@using CloudBooks.Web.Modelos
@{ ViewData["Title"] = "Solicitud institucional"; var mensaje = $"Hola, te saludamos de CloudBooks. Nos comunicamos acerca de tu solicitud institucional #{Model.Id}. Queremos darle seguimiento a tu gestión."; var whatsapp = CloudBooks.Web.Servicios.ContactoWhatsapp.CrearEnlace(Model.Usuario.PhoneNumber, mensaje) ?? CloudBooks.Web.Servicios.ContactoWhatsapp.CrearEnlace(Model.Telefono, mensaje); }
<section class="container pagina"><a class="admin-volver" asp-action="Index">← Volver a instituciones</a><div class="admin-pagina-encabezado"><p class="etiqueta">INSTITUCIONES · SOLICITUD #@Model.Id</p><h1>@Model.Institucion</h1><p>Recibida @CloudBooks.Web.ModelosVista.FechaPresentacion.Mostrar(Model.FechaUtc) · Guatemala · <span class="estado-admin estado-@Model.Estado.ToString().ToLowerInvariant()">@Model.Estado</span></p></div>
@if (TempData["Error"] != null) { <p class="alert alert-danger" role="alert">@TempData["Error"]</p> } @if (TempData["Exito"] != null) { <p class="alert alert-success" role="status">@TempData["Exito"]</p> }
<div class="admin-detalle-grid"><section class="admin-panel"><p class="etiqueta">DATOS INSTITUCIONALES</p><h2>Información de la solicitud</h2><dl class="admin-datos"><div><dt>Institución</dt><dd>@Model.Institucion</dd></div><div><dt>NIT</dt><dd>@Model.Nit</dd></div><div><dt>Tipo</dt><dd>@Model.TipoInstitucion</dd></div><div><dt>Representante</dt><dd>@Model.Representante</dd></div><div class="ancho-completo"><dt>Dirección</dt><dd>@Model.Direccion</dd></div></dl></section>
<aside class="admin-columna"><section class="admin-panel"><p class="etiqueta">CONTACTO</p><h2>@Model.Usuario.NombreCompleto</h2><p>@Model.Usuario.Email<br />@Model.Telefono</p>@if (whatsapp != null) { <a class="admin-accion" href="@whatsapp" target="_blank" rel="noopener noreferrer">Contactar por WhatsApp ↗</a> }</section><section class="admin-panel"><p class="etiqueta">DECISIÓN</p><h2>Seguimiento</h2>@if (Model.Estado == EstadoSolicitudInstitucional.Pendiente) { <p>Revisa los datos antes de resolver la solicitud.</p><div class="acciones-pedido"><form asp-action="Resolver" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="aprobar" value="true" /><button class="boton" type="submit">Aprobar</button></form><form asp-action="Resolver" method="post" onsubmit="return confirm('¿Rechazar esta solicitud institucional?')"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="aprobar" value="false" /><button class="boton-peligro" type="submit">Rechazar</button></form></div> } else { <p>Esta solicitud ya fue resuelta.</p> }</section></aside></div></section>
