@model CloudBooks.Web.Modelos.SolicitudInstitucional
@using CloudBooks.Web.Modelos
@{ ViewData["Title"] = "Solicitud institucional"; }
<section class="container pagina"><a asp-action="Index">← Solicitudes institucionales</a><h1>Solicitud institucional</h1>
@if (TempData["Error"] != null) { <p class="alert alert-danger" role="alert">@TempData["Error"]</p> }
@if (TempData["Exito"] != null) { <p class="alert alert-success" role="status">@TempData["Exito"]</p> }
<p>Estado: <strong>@Model.Estado</strong></p><dl class="ficha"><div><dt>Solicitante</dt><dd>@Model.Usuario.NombreCompleto (@Model.Usuario.Email)</dd></div><div><dt>Institución</dt><dd>@Model.Institucion</dd></div><div><dt>NIT</dt><dd>@Model.Nit</dd></div><div><dt>Tipo</dt><dd>@Model.TipoInstitucion</dd></div><div><dt>Teléfono</dt><dd>@Model.Telefono</dd></div><div><dt>Dirección</dt><dd>@Model.Direccion</dd></div><div><dt>Representante</dt><dd>@Model.Representante</dd></div></dl>
@{ var whatsapp = CloudBooks.Web.Servicios.ContactoWhatsapp.CrearEnlace(Model.Usuario.PhoneNumber ?? Model.Telefono, $"Hola {Model.Usuario.NombreCompleto}, somos CloudBooks. Nos comunicamos por tu solicitud institucional."); }
@if (whatsapp != null) { <p><a href="@whatsapp" target="_blank" rel="noopener noreferrer">Contactar por WhatsApp ↗</a></p> }
@if (Model.Estado == EstadoSolicitudInstitucional.Pendiente) { <div class="acciones-pedido"><form asp-action="Resolver" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="aprobar" value="true" /><button class="boton" type="submit">Aprobar</button></form><form asp-action="Resolver" method="post" onsubmit="return confirm('¿Rechazar esta solicitud institucional?')"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="aprobar" value="false" /><button class="boton-peligro" type="submit">Rechazar</button></form></div> }</section>
