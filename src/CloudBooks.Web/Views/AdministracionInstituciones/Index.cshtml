@model List<CloudBooks.Web.Modelos.SolicitudInstitucional>
@using CloudBooks.Web.Modelos
@using CloudBooks.Web.ModelosVista
@{ ViewData["Title"] = "Instituciones"; var resumen = (List<SolicitudInstitucional>)ViewBag.Resumen; }
<section class="container pagina"><div class="admin-pagina-encabezado"><p class="etiqueta">OPERACIONES · INSTITUCIONES</p><h1>Solicitudes institucionales</h1><p>Revisa las solicitudes de acceso y da seguimiento a cada institución.</p></div>
<div class="admin-metrica-fila"><article><span>Solicitudes</span><strong>@resumen.Count</strong><small>Total registrado</small></article><article class="es-atencion"><span>Pendientes</span><strong>@resumen.Count(s => s.Estado == EstadoSolicitudInstitucional.Pendiente)</strong><small>Por revisar</small></article><article class="es-exito"><span>Aprobadas</span><strong>@resumen.Count(s => s.Estado == EstadoSolicitudInstitucional.Aprobada)</strong><small>Perfiles habilitados</small></article><article><span>Rechazadas</span><strong>@resumen.Count(s => s.Estado == EstadoSolicitudInstitucional.Rechazada)</strong><small>Solicitudes resueltas</small></article></div>
<div class="admin-panel"><div class="admin-tabla-titulo"><div><h2>Solicitudes recibidas</h2><p>@Model.Count resultado(s) · Fecha y hora de Guatemala.</p></div></div><form method="get" class="admin-filtros"><div><label for="buscar">Institución o solicitante</label><input id="buscar" name="buscar" value="@Context.Request.Query["buscar"]" placeholder="Buscar solicitud" /></div><div><label for="estado">Estado</label><select id="estado" name="estado"><option value="">Todos</option>@foreach (var e in Enum.GetValues<EstadoSolicitudInstitucional>()) { <option value="@e" selected="@(Context.Request.Query["estado"] == e.ToString())">@e</option> }</select></div><button class="boton-secundario" type="submit">Filtrar</button><a class="admin-limpiar" asp-action="Index">Limpiar</a></form>
@if (Model.Count == 0) { <div class="admin-vacio"><i data-lucide="building-2"></i><strong>No hay solicitudes para mostrar</strong><span>Las solicitudes recibidas o que coincidan con tu búsqueda aparecerán aquí.</span><a asp-action="Index">Ver todas las solicitudes</a></div> } else { <div class="tabla-responsive" tabindex="0" aria-label="Solicitudes institucionales; desplázate horizontalmente para ver todas las columnas"><table class="tabla-pedidos"><thead><tr><th>Institución</th><th>Solicitante</th><th>NIT</th><th>Tipo</th><th>Recibida</th><th>Estado</th><th>Acción</th></tr></thead><tbody>
@foreach (var s in Model) { <tr><td><strong>@s.Institucion</strong></td><td>@s.Usuario.NombreCompleto</td><td>@s.Nit</td><td>@s.TipoInstitucion</td><td><span class="admin-fecha">@FechaPresentacion.Mostrar(s.FechaUtc)</span></td><td><span class="estado-admin estado-@s.Estado.ToString().ToLowerInvariant()">@s.Estado</span></td><td><a class="admin-accion" asp-action="Detalle" asp-route-id="@s.Id">Ver solicitud →</a></td></tr> }
</tbody></table></div> }</div></section>
