@model CloudBooks.Web.ModelosVista.CatalogoModelo
@using CloudBooks.Web.Modelos
@{ ViewData["Title"] = "Catálogo"; }
<section class="container pagina catalogo">
    <p class="etiqueta">ENCUENTRA TU PRÓXIMA LECTURA</p><h1>Explora el catálogo</h1>
    <p class="intro">Historias e ideas para cada curiosidad.</p>
    <form method="get" class="filtros" role="search">
        <div class="busqueda"><label asp-for="Buscar">Buscar</label><input asp-for="Buscar" placeholder="Título, autor, ISBN o editorial" /></div>
        <div><label asp-for="CategoriaId">Categoría</label><select asp-for="CategoriaId"><option value="">Todas</option>@foreach (var categoria in Model.Categorias) { <option value="@categoria.Id">@categoria.Nombre</option> }</select></div>
        <div><label asp-for="Formato">Formato</label><select asp-for="Formato"><option value="">Todos</option><option value="0">Tapa blanda</option><option value="1">Tapa dura</option><option value="2">E-book</option></select></div>
        <div><label asp-for="PrecioMinimo">Precio mínimo (Q)</label><input asp-for="PrecioMinimo" type="number" min="0" step="0.01" /></div>
        <div><label asp-for="PrecioMaximo">Precio máximo (Q)</label><input asp-for="PrecioMaximo" type="number" min="0" step="0.01" /></div>
        <div class="orden"><label asp-for="Orden">Ordenar</label><select asp-for="Orden"><option value="">Predeterminado</option><option value="menor">Precio menor</option><option value="mayor">Precio mayor</option><option value="titulo">Título A-Z</option></select></div>
        <button class="boton" type="submit">Buscar libros</button><a class="limpiar" asp-action="Index">Limpiar</a>
        <div asp-validation-summary="All" class="errores"></div>
    </form>
    <p class="resultados">@Model.Libros.Count @(Model.Libros.Count == 1 ? "libro encontrado" : "libros encontrados")</p>
    <div class="libros-grid">
    @foreach (var libro in Model.Libros) {
        <article class="libro-tarjeta">
            <a asp-action="Detalle" asp-route-id="@libro.Id"><img src="@libro.ImagenPortada" alt="Portada de @libro.Titulo" loading="lazy" /></a>
            <div class="libro-info"><p class="libro-formato">@(libro.Formato == FormatoLibro.TapaBlanda ? "Tapa blanda" : libro.Formato == FormatoLibro.TapaDura ? "Tapa dura" : "E-book")</p>
            <h2><a asp-action="Detalle" asp-route-id="@libro.Id">@libro.Titulo</a></h2><p>@string.Join(", ", libro.Autores.Select(a => a.Nombre))</p>
            <strong>Q@(libro.PrecioBase.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))</strong><p class="disponibilidad">@(libro.Formato == FormatoLibro.Ebook ? "Disponible en digital" : libro.Stock > 0 ? "Disponible" : "Sin existencias")</p>
            <a class="enlace-libro" asp-action="Detalle" asp-route-id="@libro.Id">Ver libro <span aria-hidden="true">→</span></a></div>
        </article>
    }
    </div>
    @if (Model.Libros.Count == 0 && ViewData.ModelState.IsValid) { <p>No encontramos libros con esos filtros. Prueba otra búsqueda.</p> }
</section>
