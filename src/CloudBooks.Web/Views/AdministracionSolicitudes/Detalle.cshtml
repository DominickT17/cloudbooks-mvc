@model CloudBooks.Web.Modelos.SolicitudCotizacion
@{ ViewData["Title"] = Model.Codigo; var whatsapp = CloudBooks.Web.Servicios.ContactoWhatsapp.CrearEnlace(Model.Usuario.PhoneNumber, $"Hola {Model.Usuario.NombreCompleto}, somos CloudBooks. Nos comunicamos por tu solicitud {Model.Codigo}."); }
<section class="container pagina"><a class="admin-volver" asp-action="Index">← Volver a solicitudes</a><div class="admin-pagina-encabezado"><p class="etiqueta">SOLICITUD COMERCIAL</p><h1>@Model.Codigo</h1><p>@Model.PerfilInstitucional.Institucion · Recibida @CloudBooks.Web.ModelosVista.FechaPresentacion.Mostrar(Model.FechaUtc) · Guatemala</p></div>
@if (TempData["Error"] != null) { <p class="alert alert-danger" role="alert">@TempData["Error"]</p> } @if (TempData["Exito"] != null) { <p class="alert alert-success" role="status">@TempData["Exito"]</p> }
<div class="admin-detalle-grid"><section class="admin-panel"><p class="etiqueta">DETALLE</p><h2>Información de la solicitud</h2><partial name="_SolicitudEspecial" model="Model" /></section><aside class="admin-columna"><section class="admin-panel"><p class="etiqueta">CONTACTO</p><h2>@Model.Usuario.NombreCompleto</h2><p>@Model.Usuario.Email<br />@(Model.Usuario.PhoneNumber ?? "Sin teléfono registrado")</p>@if (whatsapp != null) { <a class="admin-accion" href="@whatsapp" target="_blank" rel="noopener noreferrer">Contactar por WhatsApp ↗</a> }</section><section class="admin-panel"><p class="etiqueta">SEGUIMIENTO</p><h2>Asesor asignado</h2><p>@(Model.Asesor?.NombreCompleto ?? "Pendiente de asignación")</p>@if (Model.AsesorId == null && Model.Estado == CloudBooks.Web.Modelos.EstadoSolicitudCotizacion.Solicitada) { <form asp-action="Asignar" method="post"><input type="hidden" name="id" value="@Model.Id" /><button class="boton" type="submit">Asignar asesor disponible</button></form> }</section></aside></div></section>
