@model List<CloudBooks.Web.Modelos.SolicitudCotizacion>
@using CloudBooks.Web.Modelos
@using CloudBooks.Web.ModelosVista
@{ ViewData["Title"] = "Solicitudes comerciales"; var resumen = (List<SolicitudCotizacion>)ViewBag.Resumen; }
<section class="container pagina"><div class="admin-pagina-encabezado"><p class="etiqueta">OPERACIONES · INSTITUCIONES</p><h1>Solicitudes comerciales</h1><p>Da seguimiento a obras especiales desde la solicitud hasta su cotización.</p></div>
<div class="admin-metrica-fila"><article><span>Solicitudes</span><strong>@resumen.Count</strong><small>Total registrado</small></article><article class="es-atencion"><span>Por atender</span><strong>@resumen.Count(s => s.Estado == EstadoSolicitudCotizacion.Solicitada)</strong><small>Solicitudes recibidas</small></article><article><span>En revisión</span><strong>@resumen.Count(s => s.Estado == EstadoSolicitudCotizacion.EnRevision)</strong><small>Con seguimiento</small></article><article class="es-exito"><span>Cotizadas o resueltas</span><strong>@resumen.Count(s => s.Estado != EstadoSolicitudCotizacion.Solicitada && s.Estado != EstadoSolicitudCotizacion.EnRevision)</strong><small>Ya procesadas</small></article></div>
<div class="admin-panel"><div class="admin-tabla-titulo"><div><h2>Seguimiento de solicitudes</h2><p>@Model.Count resultado(s) · Fecha y hora de Guatemala.</p></div></div><form method="get" class="admin-filtros"><div><label for="buscar">Institución, obra o código</label><input id="buscar" name="buscar" value="@Context.Request.Query["buscar"]" placeholder="Buscar solicitud" /></div><div><label for="estado">Estado</label><select id="estado" name="estado"><option value="">Todos</option>@foreach (var e in Enum.GetValues<EstadoSolicitudCotizacion>()) { <option value="@e" selected="@(Context.Request.Query["estado"] == e.ToString())">@(e == EstadoSolicitudCotizacion.EnRevision ? "En revisión" : e.ToString())</option> }</select></div><button class="boton-secundario" type="submit">Filtrar</button><a class="admin-limpiar" asp-action="Index">Limpiar</a></form>
@if (Model.Count == 0) { <div class="admin-vacio"><i data-lucide="clipboard-list"></i><strong>No hay solicitudes para mostrar</strong><span>Las solicitudes comerciales recibidas aparecerán aquí.</span><a asp-action="Index">Ver todas las solicitudes</a></div> } else { <div class="tabla-responsive" tabindex="0" aria-label="Solicitudes comerciales; desplázate horizontalmente para ver todas las columnas"><table class="tabla-pedidos"><thead><tr><th>Solicitud</th><th>Institución</th><th>Obra</th><th>Cantidad</th><th>Asesor</th><th>Recibida</th><th>Estado</th><th>Acción</th></tr></thead><tbody>
@foreach (var s in Model) { <tr><td><strong>@s.Codigo</strong></td><td>@s.PerfilInstitucional.Institucion</td><td>@s.Titulo</td><td>@s.Cantidad</td><td>@(s.Asesor?.NombreCompleto ?? "Sin asignar")</td><td><span class="admin-fecha">@FechaPresentacion.Mostrar(s.FechaUtc)</span></td><td><span class="estado-admin estado-@s.Estado.ToString().ToLowerInvariant()">@(s.Estado == EstadoSolicitudCotizacion.EnRevision ? "En revisión" : s.Estado.ToString())</span></td><td><a class="admin-accion" asp-action="Detalle" asp-route-id="@s.Id">Ver seguimiento →</a></td></tr> }
</tbody></table></div> }</div></section>
