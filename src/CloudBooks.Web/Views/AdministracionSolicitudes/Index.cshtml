@model List<CloudBooks.Web.Modelos.SolicitudCotizacion>
@{ ViewData["Title"] = "Solicitudes comerciales"; }
<section class="container pagina"><a asp-controller="Administracion" asp-action="Index">← Administración</a><h1>Solicitudes comerciales</h1><div class="tabla-responsive"><table class="tabla-pedidos"><thead><tr><th>Código</th><th>Institución</th><th>Obra</th><th>Cantidad</th><th>Asesor</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach (var s in Model) { <tr><td>@s.Codigo</td><td>@s.PerfilInstitucional.Institucion</td><td>@s.Titulo</td><td>@s.Cantidad</td><td>@(s.Asesor?.NombreCompleto ?? "Pendiente de asignación")</td><td><span class="estado-admin estado-@s.Estado.ToString().ToLowerInvariant()">@s.Estado</span></td><td><a asp-action="Detalle" asp-route-id="@s.Id">Ver</a></td></tr> }</tbody></table></div>@if (Model.Count == 0) { <p class="estado-vacio">No hay solicitudes comerciales para mostrar.</p> }</section>
