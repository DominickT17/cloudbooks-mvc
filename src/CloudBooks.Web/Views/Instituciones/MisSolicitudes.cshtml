@model List<CloudBooks.Web.Modelos.SolicitudInstitucional>
@{ ViewData["Title"] = "Mis solicitudes institucionales"; }
<section class="container pagina"><p class="etiqueta">TU CUENTA</p><h1>Mis solicitudes institucionales</h1>
@if (TempData["Exito"] != null) { <p class="alert alert-success" role="status">@TempData["Exito"]</p> }
@if (Model.Count == 0) { <p>Aún no tienes solicitudes.</p> }
else { <div class="tabla-responsive"><table class="tabla-pedidos"><thead><tr><th>Institución</th><th>Fecha (UTC)</th><th>Estado</th></tr></thead><tbody>
@foreach (var solicitud in Model) { <tr><td>@solicitud.Institucion</td><td>@solicitud.FechaUtc.ToString("dd/MM/yyyy")</td><td>@solicitud.Estado</td></tr> }
</tbody></table></div> }
<a asp-controller="Inicio" asp-action="Instituciones">Volver a instituciones</a></section>
