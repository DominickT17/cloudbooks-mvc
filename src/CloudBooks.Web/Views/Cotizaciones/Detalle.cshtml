@model CloudBooks.Web.Modelos.Cotizacion
@using CloudBooks.Web.Modelos
@{ ViewData["Title"] = Model.Codigo; string Dinero(decimal n) => "Q" + n.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture); }
<section class="container pagina"><p class="etiqueta">CLOUDBOOKS · COTIZACIÓN</p><h1>@Model.Codigo</h1><p>Estado: <strong>@Model.Estado</strong> · Emitida @Model.FechaUtc.ToString("dd/MM/yyyy") UTC · Vence @Model.FechaVencimiento.ToString("dd/MM/yyyy")</p>
@if (TempData["Exito"] != null) { <p class="alert alert-success">@TempData["Exito"]</p> } @if (TempData["Error"] != null) { <p class="alert alert-danger">@TempData["Error"]</p> }
<p>Institución: @Model.Solicitud.PerfilInstitucional.Institucion · Cliente: @Model.Solicitud.Usuario.NombreCompleto · Asesor: @Model.Solicitud.Asesor?.NombreCompleto</p>
@if (User.IsInRole("Administrador") || User.IsInRole("AsesorVentas")) { var whatsapp = CloudBooks.Web.Servicios.ContactoWhatsapp.CrearEnlace(Model.Solicitud.Usuario.PhoneNumber, $"Hola {Model.Solicitud.Usuario.NombreCompleto}, somos CloudBooks. Nos comunicamos por tu cotización {Model.Codigo}."); if (whatsapp != null) { <p><a href="@whatsapp" target="_blank" rel="noopener noreferrer">Contactar por WhatsApp ↗</a></p> } }
<div class="compra-grid"><div><h2>Propuesta</h2>@foreach (var d in Model.Detalles) { <div class="linea-resumen"><strong>@d.Concepto</strong><span>@d.Cantidad × @Dinero(d.PrecioUnitario) = @Dinero(d.Subtotal)</span></div> }</div>
<aside class="resumen-compra"><h2>Resumen</h2><dl><div><dt>Subtotal</dt><dd>@Dinero(Model.Subtotal)</dd></div><div><dt>Descuento por volumen</dt><dd>−@Dinero(Model.DescuentoVolumen)</dd></div><div><dt>Descuento institucional</dt><dd>−@Dinero(Model.DescuentoInstitucional)</dd></div><div><dt>IVA (@((Model.TasaImpuesto * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)) %)</dt><dd>@Dinero(Model.Impuesto)</dd></div><div class="total"><dt>Total</dt><dd>@Dinero(Model.Total)</dd></div></dl></aside></div>
<div class="acciones-pedido"><a class="boton" asp-action="Pdf" asp-route-id="@Model.Id">Descargar PDF</a>
@if (Model.Estado == EstadoSolicitudCotizacion.Cotizada && User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.Solicitud.UsuarioId && User.IsInRole("ClienteInstitucional")) { <form asp-action="Responder" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="aceptar" value="true" /><button class="boton" type="submit">Aceptar</button></form><form asp-action="Responder" method="post"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="aceptar" value="false" /><button type="submit">Rechazar</button></form> }</div></section>
