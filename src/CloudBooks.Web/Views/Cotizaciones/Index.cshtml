@model List<CloudBooks.Web.Modelos.Cotizacion>
@using CloudBooks.Web.Modelos
@using CloudBooks.Web.ModelosVista
@{ ViewData["Title"] = User.IsInRole("Administrador") ? "Cotizaciones" : "Mis cotizaciones"; string Dinero(decimal n) => "Q" + n.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture); var admin = User.IsInRole("Administrador"); var hoy = DateOnly.FromDateTime(DateTime.UtcNow); }
@if (admin) {
    var resumen = (List<Cotizacion>)ViewBag.Resumen;
    <section class="container pagina"><div class="admin-pagina-encabezado"><p class="etiqueta">OPERACIONES · PROPUESTAS</p><h1>Cotizaciones</h1><p>Consulta la vigencia y el seguimiento de las propuestas institucionales.</p></div>
    <div class="admin-metrica-fila"><article><span>Vigentes · pendientes</span><strong>@resumen.Count(c => c.Estado == EstadoSolicitudCotizacion.Cotizada && c.FechaVencimiento >= hoy)</strong><small>En espera de respuesta</small></article><article class="es-atencion"><span>Próximas a vencer</span><strong>@resumen.Count(c => c.Estado == EstadoSolicitudCotizacion.Cotizada && c.FechaVencimiento >= hoy && c.FechaVencimiento <= hoy.AddDays(7))</strong><small>En los próximos 7 días</small></article><article class="es-exito"><span>Aceptadas</span><strong>@resumen.Count(c => c.Estado == EstadoSolicitudCotizacion.Aceptada)</strong><small>Propuestas aceptadas</small></article><article><span>Finalizadas</span><strong>@resumen.Count(c => c.Estado == EstadoSolicitudCotizacion.Rechazada || c.Estado == EstadoSolicitudCotizacion.Vencida)</strong><small>Rechazadas @resumen.Count(c => c.Estado == EstadoSolicitudCotizacion.Rechazada) · Vencidas @resumen.Count(c => c.Estado == EstadoSolicitudCotizacion.Vencida)</small></article></div>
    <div class="admin-panel"><div class="admin-tabla-titulo"><div><h2>Propuestas emitidas</h2><p>@Model.Count resultado(s) · Fechas de emisión en hora de Guatemala.</p></div></div><form method="get" class="admin-filtros"><div><label for="buscar">Institución o código</label><input id="buscar" name="buscar" value="@Context.Request.Query["buscar"]" placeholder="Buscar cotización" /></div><div><label for="estado">Estado</label><select id="estado" name="estado"><option value="">Todos</option>@foreach (var e in new[] { EstadoSolicitudCotizacion.Cotizada, EstadoSolicitudCotizacion.Aceptada, EstadoSolicitudCotizacion.Rechazada, EstadoSolicitudCotizacion.Vencida }) { <option value="@e" selected="@(Context.Request.Query["estado"] == e.ToString())">@(e == EstadoSolicitudCotizacion.Cotizada ? "Pendiente" : e.ToString())</option> }</select></div><button class="boton-secundario" type="submit">Filtrar</button><a class="admin-limpiar" asp-action="Administracion">Limpiar</a></form>
    @if (Model.Count == 0) { <div class="admin-vacio"><i data-lucide="file-text"></i><strong>No hay cotizaciones para mostrar</strong><span>Las propuestas emitidas aparecerán aquí.</span><a asp-action="Administracion">Ver todas las cotizaciones</a></div> } else { <div class="tabla-responsive" tabindex="0" aria-label="Cotizaciones; desplázate horizontalmente para ver todas las columnas"><table class="tabla-pedidos"><thead><tr><th>Cotización</th><th>Institución</th><th>Asesor</th><th>Emitida</th><th>Vence</th><th>Total</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
    @foreach (var c in Model) { var proxima = c.Estado == EstadoSolicitudCotizacion.Cotizada && c.FechaVencimiento >= hoy && c.FechaVencimiento <= hoy.AddDays(7); <tr><td><strong>@c.Codigo</strong></td><td>@c.Solicitud.PerfilInstitucional.Institucion</td><td>@(c.Solicitud.Asesor?.NombreCompleto ?? "Sin asignar")</td><td><span class="admin-fecha">@FechaPresentacion.Mostrar(c.FechaUtc)</span></td><td>@c.FechaVencimiento.ToString("dd/MM/yyyy")@if (proxima) { <small class="admin-prioridad">Próxima a vencer</small> }</td><td><strong>@Dinero(c.Total)</strong></td><td><span class="estado-admin estado-@c.Estado.ToString().ToLowerInvariant()">@(c.Estado == EstadoSolicitudCotizacion.Cotizada ? "Pendiente" : c.Estado.ToString())</span></td><td><div class="admin-acciones-fila"><a class="admin-accion" asp-action="Detalle" asp-route-id="@c.Id">Ver</a><a class="admin-accion" asp-action="Pdf" asp-route-id="@c.Id">PDF</a><a class="admin-accion" asp-controller="AdministracionSolicitudes" asp-action="Detalle" asp-route-id="@c.SolicitudCotizacionId">Solicitud</a></div></td></tr> }
    </tbody></table></div> }</div></section>
} else {
    <section class="container pagina"><h1>@ViewData["Title"]</h1><div class="tabla-responsive"><table class="tabla-pedidos"><thead><tr><th>Código</th><th>Institución</th><th>Asesor</th><th>Fecha (UTC)</th><th>Vence</th><th>Total</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach (var c in Model) { <tr><td>@c.Codigo</td><td>@c.Solicitud.PerfilInstitucional.Institucion</td><td>@c.Solicitud.Asesor?.NombreCompleto</td><td>@c.FechaUtc.ToString("dd/MM/yyyy")</td><td>@c.FechaVencimiento.ToString("dd/MM/yyyy")</td><td>@Dinero(c.Total)</td><td><span class="estado-admin estado-@c.Estado.ToString().ToLowerInvariant()">@c.Estado</span></td><td><a asp-action="Detalle" asp-route-id="@c.Id">Ver</a></td></tr> }</tbody></table></div>@if (Model.Count == 0) { <p class="estado-vacio">No hay cotizaciones para mostrar.</p> }</section>
}
