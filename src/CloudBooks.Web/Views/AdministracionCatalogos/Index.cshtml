@model List<CloudBooks.Web.Servicios.EntradaCatalogo>
@{ string tipo = ViewBag.Tipo; ViewData["Title"] = "Autores, categorías y editoriales"; }
<section class="container pagina"><a asp-controller="AdministracionCatalogo" asp-action="Index">← Catálogo</a><h1>Autores, categorías y editoriales</h1>
<nav class="acciones-pedido" aria-label="Tipo de catálogo"><a asp-route-tipo="autores">Autores</a><a asp-route-tipo="categorias">Categorías</a><a asp-route-tipo="editoriales">Editoriales</a></nav><h2>@tipo</h2>
@if (TempData["Error"] != null) { <p class="alert alert-danger">@TempData["Error"]</p> } @if (TempData["Exito"] != null) { <p class="alert alert-success">@TempData["Exito"]</p> }
<form asp-action="Guardar" method="post" class="filtro-estado"><input type="hidden" name="tipo" value="@tipo" /><input type="hidden" name="id" value="0" /><label for="nuevo">Nuevo nombre</label><input id="nuevo" name="nombre" maxlength="150" required /><button class="boton" type="submit">Crear</button></form>
<div class="tabla-responsive"><table class="tabla-pedidos"><thead><tr><th>Nombre</th><th>Editar</th></tr></thead><tbody>@foreach (var entrada in Model) { <tr><td>@entrada.Nombre</td><td><form asp-action="Guardar" method="post" class="filtro-estado"><input type="hidden" name="tipo" value="@tipo" /><input type="hidden" name="id" value="@entrada.Id" /><label for="nombre-@entrada.Id">Nombre</label><input id="nombre-@entrada.Id" name="nombre" value="@entrada.Nombre" maxlength="150" required /><button type="submit">Guardar</button></form></td></tr> }</tbody></table></div></section>
