@model List<CloudBooks.Web.Modelos.CorreoPendiente>
@{ ViewData["Title"] = "Correos"; }
<section class="container pagina"><div class="admin-pagina-encabezado"><p class="etiqueta">NOTIFICACIONES</p><h1>Historial de correos</h1><p>«Aceptado» indica que el proveedor recibió el mensaje; no confirma entrega al buzón. Simulado no implica envío.</p></div><div class="admin-panel">
@if (Model.Count == 0) { <p>No hay correos registrados.</p> } else { <div class="tabla-responsive"><table class="tabla-pedidos"><thead><tr><th>Fecha UTC</th><th>Tipo / referencia</th><th>Destinatario</th><th>Asunto</th><th>Estado</th><th>Intentos</th><th></th></tr></thead><tbody>@foreach (var correo in Model) { <tr><td>@correo.CreadoUtc.ToString("dd/MM/yyyy HH:mm")</td><td>@correo.Tipo · @correo.Referencia</td><td>@correo.Destinatario</td><td>@correo.Asunto</td><td>@correo.Estado</td><td>@correo.Intentos</td><td><a asp-action="Detalle" asp-route-id="@correo.Id">Ver detalle</a></td></tr> }</tbody></table></div> }
</div></section>
