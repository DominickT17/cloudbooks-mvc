@model IReadOnlyList<CloudBooks.Web.Servicios.EjemploCorreo>
@{ ViewData["Title"] = "Plantillas de demostración"; }
<section class="container pagina admin-ejemplos-correo"><a asp-action="Index">← Historial de correos</a><div class="admin-pagina-encabezado"><p class="etiqueta">SOLO DEVELOPMENT</p><h1>Plantillas de demostración</h1><p>Datos ficticios. Esta vista no crea ni envía correos. Sin una URL pública configurada no se muestran botones hacia la aplicación. Los enlaces de los ejemplos son ilustrativos y pueden no corresponder a registros reales.</p></div>
<div class="admin-preview-ancho" role="group" aria-label="Ancho de vista previa"><strong>Ancho de correo</strong><button type="button" data-correo-ancho="600" aria-pressed="true">600 px</button><button type="button" data-correo-ancho="430" aria-pressed="false">430 px</button><button type="button" data-correo-ancho="375" aria-pressed="false">375 px</button><small>El ancho se reduce si la pantalla no tiene espacio suficiente.</small></div>
@foreach (var ejemplo in Model) { <details class="admin-panel"><summary><strong>@ejemplo.Nombre</strong> · @ejemplo.Asunto</summary><p>Vista HTML aislada de la comunicación.</p><iframe title="Vista previa: @ejemplo.Nombre" sandbox srcdoc="@ejemplo.Html" class="admin-preview-correo"></iframe><details><summary>Versión de texto plano</summary><pre style="white-space:pre-wrap">@ejemplo.Texto</pre></details></details> }
</section>
