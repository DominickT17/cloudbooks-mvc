@model IReadOnlyList<CloudBooks.Web.Servicios.EjemploCorreo>
@{ ViewData["Title"] = "Plantillas de demostración"; }
<section class="container pagina"><a asp-action="Index">← Historial de correos</a><div class="admin-pagina-encabezado"><p class="etiqueta">SOLO DEVELOPMENT</p><h1>Plantillas de demostración</h1><p>Datos ficticios. Esta vista no crea ni envía correos. Sin una URL pública configurada no se muestran botones hacia la aplicación.</p></div>
@foreach (var ejemplo in Model) { <details class="admin-panel"><summary><strong>@ejemplo.Nombre</strong> · @ejemplo.Asunto</summary><p>Vista HTML aislada; reduce el ancho para revisarla en móvil.</p><iframe title="Vista previa: @ejemplo.Nombre" sandbox srcdoc="@ejemplo.Html" style="display:block;width:100%;max-width:650px;height:670px;resize:horizontal;border:1px solid #d8e3ef;background:#edf3f8"></iframe><details><summary>Versión de texto plano</summary><pre style="white-space:pre-wrap">@ejemplo.Texto</pre></details></details> }
</section>
