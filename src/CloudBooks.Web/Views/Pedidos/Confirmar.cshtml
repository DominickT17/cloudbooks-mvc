@model CloudBooks.Web.ModelosVista.CarritoModelo
@using CloudBooks.Web.Servicios
@inject Microsoft.Extensions.Configuration.IConfiguration Configuracion
@{ ViewData["Title"] = "Confirmar compra"; string Dinero(decimal n) => "Q" + n.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture); }
<section class="container pagina checkout"><a class="checkout-volver" asp-controller="Carrito" asp-action="Index">← Volver al carrito</a><div class="checkout-encabezado"><div><p class="etiqueta">ÚLTIMO PASO</p><h1>Confirmar compra</h1><p>Revisa tus libros y selecciona cómo quieres simular el pago.</p></div><span class="checkout-sello"><i data-lucide="shield-check"></i> Compra académica</span></div>
<div class="checkout-aviso" role="note"><i data-lucide="info"></i><p><strong>Pago simulado</strong><br />Pago simulado para demostración académica. No introduzcas datos de tarjetas reales.</p></div>
@if (TempData["Error"] != null) { <p class="alert alert-danger" role="alert">@TempData["Error"]</p> }
<div class="compra-grid"><div class="checkout-pasos"><section class="checkout-panel"><div class="checkout-titulo"><span>01</span><div><h2>Productos</h2><p>Comprueba tu selección antes de confirmar.</p></div></div>
@foreach (var detalle in Model.Detalles) { <div class="linea-resumen"><strong>@detalle.Libro.Titulo</strong><span>@detalle.Cantidad × @Dinero(detalle.Libro.PrecioBase) = @Dinero(detalle.Cantidad * detalle.Libro.PrecioBase)</span></div> }</section>
<section class="checkout-panel"><div class="checkout-titulo"><span>02</span><div><h2>Método de pago</h2><p>Selecciona una opción de demostración.</p></div></div>
<form asp-action="Crear" method="post" class="checkout-formulario">
<fieldset><legend>Pago simulado</legend><div class="checkout-metodos">
<label><input type="radio" name="metodo" value="0" required aria-describedby="mensaje-metodo" /><i data-lucide="credit-card" aria-hidden="true"></i><span><strong>Tarjeta simulada</strong><small>Usa solo tarjetas ficticias.</small></span></label>
<label><input type="radio" name="metodo" value="1" required aria-describedby="mensaje-metodo" /><i data-lucide="landmark" aria-hidden="true"></i><span><strong>Transferencia simulada</strong><small>Sin transferencia bancaria real.</small></span></label>
</div><p id="mensaje-metodo" class="checkout-instruccion" aria-live="polite">Selecciona un método de pago</p></fieldset>
<fieldset id="datos-tarjeta" class="checkout-datos" hidden disabled><legend>Datos de tarjeta ficticia</legend><p>Utiliza únicamente datos de prueba.</p><div class="checkout-campos">
<div class="ancho-completo"><label for="titular">Nombre del titular</label><input id="titular" name="titular" maxlength="150" autocomplete="off" required /></div>
<div class="ancho-completo"><label for="numero">Número de tarjeta ficticia</label><input id="numero" name="numero" inputmode="numeric" placeholder="1234-5678-9012-3456" autocomplete="off" aria-describedby="error-numero nota-tarjeta" required /><small class="checkout-error" id="error-numero" aria-live="polite"></small></div>
<div><label for="vencimiento">Vencimiento (MM/AA)</label><input id="vencimiento" name="vencimiento" inputmode="numeric" placeholder="12/35" autocomplete="off" aria-describedby="error-vencimiento" required /><small class="checkout-error" id="error-vencimiento" aria-live="polite"></small></div>
<div><label for="cvv">CVV ficticio</label><input id="cvv" name="cvv" inputmode="numeric" placeholder="123" autocomplete="off" aria-describedby="error-cvv" required /><small class="checkout-error" id="error-cvv" aria-live="polite"></small></div></div>
<small id="nota-tarjeta">El número completo y el CVV no se guardan.</small><details class="checkout-tarjetas"><summary>Ver tarjetas de prueba</summary><ul><li>4000-0000-0000-0002 · Aprobada</li><li>4000-0000-0000-0010 · Fondos insuficientes</li><li>4000-0000-0000-0028 · Rechazada</li><li>4000-0000-0000-0036 · Bloqueada</li></ul><p>Vencimiento de ejemplo: 12/35 · CVV ficticio: 123.</p></details></fieldset>
<section id="datos-transferencia" class="checkout-datos" hidden aria-labelledby="titulo-transferencia"><h3 id="titulo-transferencia">Datos para transferencia simulada</h3><p class="checkout-advertencia"><strong>Transferencia simulada para fines académicos. No realices transferencias bancarias reales.</strong> La autorización es ficticia y no existe verificación bancaria.</p>
<div class="checkout-bancos">
@foreach (var banco in new[] { (Clave: "Banrural", Nombre: "Banrural", Tipo: "Cuenta de Ahorros"), (Clave: "Industrial", Nombre: "Banco Industrial", Tipo: "Cuenta Monetaria") })
{
    var cuenta = Configuracion[$"TransferenciaSimulada:{banco.Clave}:Numero"];
    var titularCuenta = Configuracion[$"TransferenciaSimulada:{banco.Clave}:Titular"];
    <article class="checkout-banco"><h4><i data-lucide="landmark" aria-hidden="true"></i> @banco.Nombre</h4><p>@banco.Tipo</p>
    @if (!string.IsNullOrWhiteSpace(cuenta) && !string.IsNullOrWhiteSpace(titularCuenta)) {
        <dl><div><dt>Número de cuenta</dt><dd class="numero-cuenta">@cuenta</dd></div><div><dt>Titular</dt><dd>@titularCuenta</dd></div></dl>
        <button type="button" class="checkout-copiar" data-copiar-cuenta>Copiar número</button>
    } else { <p class="checkout-pendiente">Configuración pendiente para esta cuenta.</p> }
    </article>
}
</div><p id="resultado-copia" class="checkout-copia-estado" role="status"></p></section>
<div class="checkout-confirmacion"><h3>Confirmación</h3><p>Al confirmar se procesará un pedido académico con pago simulado.</p><button class="boton" type="submit">Confirmar pedido</button></div></form></section></div>
<aside class="resumen-compra checkout-resumen"><h2>Resumen de compra</h2><p>Importes de esta operación simulada.</p><dl><div><dt>Subtotal</dt><dd>@Dinero(Model.Resumen!.Subtotal)</dd></div><div><dt>Descuento por volumen (@(ServicioDescuentos.ObtenerTasaVolumen(Model.CantidadTotal) * 100) %)</dt><dd>−@Dinero(Model.Resumen.DescuentoVolumen)</dd></div>@if (Model.Institucional) { <div><dt>Descuento institucional (8 %)</dt><dd>−@Dinero(Model.Resumen.DescuentoInstitucional)</dd></div> }<div><dt>IVA (@((Model.Resumen.TasaImpuesto * 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)) %)</dt><dd>@Dinero(Model.Resumen.Impuesto)</dd></div><div class="total"><dt>Total</dt><dd>@Dinero(Model.Resumen.Total)</dd></div></dl><a asp-controller="Carrito" asp-action="Index">Editar carrito</a></aside></div></section>
@section Scripts { <script src="~/js/checkout.js" asp-append-version="true"></script> }
