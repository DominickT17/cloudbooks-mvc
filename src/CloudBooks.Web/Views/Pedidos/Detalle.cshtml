@model CloudBooks.Web.Modelos.Pedido
@{ ViewData["Title"] = Model.Codigo; }
<section class="container pagina"><a asp-action="Index">← Mis pedidos</a><h1>@Model.Codigo</h1><p>Estado: <strong>@Model.EstadoTexto</strong> · @Model.FechaUtc.ToString("dd/MM/yyyy HH:mm") UTC</p>
@if (TempData["Exito"] != null) { <p class="alert alert-success">@TempData["Exito"]</p> }
@if (Model.Estado == CloudBooks.Web.Modelos.EstadoPedido.EnRevision) { <p class="alert alert-info">Tu pedido requiere una revisión. Nuestro equipo lo validará pronto.</p> }
<partial name="_DetallePedido" model="Model" />
@if (Model.Estado == CloudBooks.Web.Modelos.EstadoPedido.Aprobado || Model.Estado == CloudBooks.Web.Modelos.EstadoPedido.Enviado) { <a class="boton-secundario" asp-action="Comprobante" asp-route-id="@Model.Id">Descargar comprobante de compra</a> }</section>
