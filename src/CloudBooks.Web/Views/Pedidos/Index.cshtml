@model List<CloudBooks.Web.Modelos.Pedido>
@{ ViewData["Title"] = "Mis pedidos"; string Dinero(decimal n) => "Q" + n.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture); }
<section class="container pagina"><p class="etiqueta">TU CUENTA</p><h1>Mis pedidos</h1>
@if (Model.Count == 0) { <p>Aún no tienes pedidos.</p><a asp-controller="Catalogo" asp-action="Index">Explorar catálogo</a> }
else { <div class="tabla-responsive"><table class="tabla-pedidos"><thead><tr><th>Pedido</th><th>Fecha (UTC)</th><th>Total</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach (var pedido in Model) { <tr><td>@pedido.Codigo</td><td>@pedido.FechaUtc.ToString("dd/MM/yyyy HH:mm")</td><td>@Dinero(pedido.Total)</td><td>@pedido.Estado</td><td><a asp-action="Detalle" asp-route-id="@pedido.Id">Ver detalle</a></td></tr> }
</tbody></table></div> }</section>
