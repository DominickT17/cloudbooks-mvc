@model List<CloudBooks.Web.Servicios.UsuarioAdministrativo>
@{ ViewData["Title"] = "Usuarios"; var actual = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value; }
<section class="container pagina"><div class="admin-pagina-encabezado"><p class="etiqueta">GESTIÓN · DIRECTORIO</p><h1>Usuarios</h1><p>Consulta las cuentas, sus perfiles y permisos desde un solo lugar.</p></div>
@if (TempData["Error"] != null) { <p class="alert alert-danger" role="alert">@TempData["Error"]</p> } @if (TempData["Exito"] != null) { <p class="alert alert-success" role="status">@TempData["Exito"]</p> }
<div class="admin-metrica-fila"><article><span>En esta vista</span><strong>@Model.Count</strong><small>Cuentas encontradas</small></article><article class="es-exito"><span>Activas</span><strong>@Model.Count(u => u.Activo)</strong><small>Acceso habilitado</small></article><article><span>Institucionales</span><strong>@Model.Count(u => u.TienePerfilInstitucional)</strong><small>Perfiles aprobados</small></article><article><span>Equipo</span><strong>@Model.Count(u => u.Roles.Contains("Administrador") || u.Roles.Contains("AsesorVentas"))</strong><small>Administración y asesores</small></article></div>
<div class="admin-panel"><div class="admin-tabla-titulo"><div><h2>Directorio de cuentas</h2><p>@Model.Count resultado(s) · Las cuentas administradoras están protegidas.</p></div></div>
<form method="get" class="admin-filtros"><div><label for="buscar">Nombre o correo</label><input id="buscar" name="buscar" value="@Context.Request.Query["buscar"]" placeholder="Buscar cuenta" /></div><div><label for="rol">Rol</label><select id="rol" name="rol"><option value="">Todos</option>@foreach (var rol in new[] { "Administrador", "AsesorVentas", "ClienteMinorista", "ClienteInstitucional" }) { <option value="@rol" selected="@(Context.Request.Query["rol"] == rol)">@rol</option> }</select></div><div><label for="activo">Estado</label><select id="activo" name="activo"><option value="">Todos</option><option value="true" selected="@(Context.Request.Query["activo"] == "true")">Activo</option><option value="false" selected="@(Context.Request.Query["activo"] == "false")">Inactivo</option></select></div><div><label for="tipo">Tipo de cliente</label><select id="tipo" name="tipo"><option value="">Todos</option><option value="minorista" selected="@(Context.Request.Query["tipo"] == "minorista")">Minorista</option><option value="institucional" selected="@(Context.Request.Query["tipo"] == "institucional")">Institucional</option></select></div><button type="submit" class="boton-secundario">Filtrar</button><a class="admin-limpiar" asp-action="Index">Limpiar</a></form>
@if (Model.Count == 0) { <div class="admin-vacio"><i data-lucide="users-round"></i><strong>No encontramos cuentas</strong><span>Prueba con otro nombre o modifica los filtros.</span><a asp-action="Index">Ver todas las cuentas</a></div> } else { <div class="tabla-responsive" tabindex="0" aria-label="Directorio de cuentas; desplázate horizontalmente para ver todas las columnas"><table class="tabla-pedidos admin-tabla-usuarios"><thead><tr><th>Usuario</th><th>Teléfono</th><th>Roles</th><th>Perfil institucional</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@foreach (var u in Model) { var partes = (u.Nombre ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries); var iniciales = partes.Length == 0 ? "U" : string.Concat(partes.Take(2).Select(p => char.ToUpperInvariant(p[0]))); var whatsapp = CloudBooks.Web.Servicios.ContactoWhatsapp.CrearEnlace(u.Telefono, $"Hola {u.Nombre}, te saludamos de CloudBooks. Nos comunicamos para dar seguimiento a tu cuenta."); <tr><td><div class="admin-persona"><span class="admin-avatar">@iniciales</span><span><strong>@u.Nombre</strong><small>@u.Correo</small></span></div></td><td>@(u.Telefono ?? "—")</td><td>@foreach (var rol in u.Roles) { <span class="estado-admin">@rol</span> }</td><td>@(u.TienePerfilInstitucional ? "Aprobado" : "Sin perfil")</td><td><span class="estado-admin @(u.Activo ? "estado-disponible" : "estado-inactivo")">@(u.Activo ? "Activo" : "Inactivo")</span></td><td><div class="admin-acciones-fila">@if (whatsapp != null) { <a class="admin-accion" href="@whatsapp" target="_blank" rel="noopener noreferrer">WhatsApp ↗</a> }
@if (u.Id != actual && !u.Roles.Contains("Administrador")) { <details class="admin-rol"><summary>Cambiar rol</summary><form asp-action="CambiarRol" method="post" onsubmit="return confirm('¿Cambiar el rol de esta cuenta? Deberá iniciar sesión nuevamente.')"><input type="hidden" name="usuarioId" value="@u.Id" /><label for="rol-@u.Id">Nuevo rol</label><select id="rol-@u.Id" name="rol"><option value="ClienteMinorista" selected="@u.Roles.Contains("ClienteMinorista")">Cliente minorista</option><option value="ClienteInstitucional" selected="@u.Roles.Contains("ClienteInstitucional")">Cliente institucional</option><option value="AsesorVentas" selected="@u.Roles.Contains("AsesorVentas")">Asesor de ventas</option></select><button type="submit" class="boton-secundario">Guardar</button></form></details> } else { <span class="admin-protegido">Protegido</span> }</div></td></tr> }
</tbody></table></div> }</div></section>
