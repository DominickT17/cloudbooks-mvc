@model List<CloudBooks.Web.Servicios.UsuarioAdministrativo>
@{ ViewData["Title"] = "Usuarios"; var actual = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value; }
<section class="container pagina"><a asp-controller="Administracion" asp-action="Index">← Administración</a><h1>Usuarios</h1>
<p>Consulta las cuentas y sus roles. Las cuentas administradoras y tu propia cuenta están protegidas frente a cambios de rol desde esta pantalla.</p>
@if (TempData["Error"] != null) { <p class="alert alert-danger" role="alert">@TempData["Error"]</p> } @if (TempData["Exito"] != null) { <p class="alert alert-success" role="status">@TempData["Exito"]</p> }
<form method="get" class="filtro-estado"><label for="buscar">Nombre o correo</label><input id="buscar" name="buscar" value="@Context.Request.Query["buscar"]" /><button type="submit">Buscar</button></form>
<div class="tabla-responsive"><table class="tabla-pedidos"><thead><tr><th>Nombre</th><th>Correo</th><th>Roles</th><th>Perfil institucional</th><th>Estado</th><th>Cambiar rol</th></tr></thead><tbody>
@foreach (var u in Model) { <tr><td>@u.Nombre</td><td>@u.Correo</td><td>@foreach (var rol in u.Roles) { <span class="estado-admin">@rol</span> }</td><td>@(u.TienePerfilInstitucional ? "Aprobado" : "Sin perfil")</td><td>@(u.Activo ? "Activo" : "Inactivo")</td><td>
@if (u.Id != actual && !u.Roles.Contains("Administrador")) { <form asp-action="CambiarRol" method="post" class="filtro-estado" onsubmit="return confirm('¿Cambiar el rol de esta cuenta?')"><input type="hidden" name="usuarioId" value="@u.Id" /><label for="rol-@u.Id">Rol</label><select id="rol-@u.Id" name="rol"><option value="ClienteMinorista" selected="@u.Roles.Contains("ClienteMinorista")">Cliente minorista</option><option value="ClienteInstitucional" selected="@u.Roles.Contains("ClienteInstitucional")">Cliente institucional</option><option value="AsesorVentas" selected="@u.Roles.Contains("AsesorVentas")">Asesor de ventas</option></select><button type="submit">Guardar</button></form> } else { <span>Protegido</span> }</td></tr> }
</tbody></table></div>@if (Model.Count == 0) { <p class="estado-vacio">No hay usuarios que coincidan con la búsqueda.</p> }</section>
